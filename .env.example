# Copy this file to .env and edit the values. Docker Compose reads .env automatically.
# Keep .env out of git: it can hold an API key.

# Image tag. Use a fixed version in production, for example :0.1.1
#   ghcr.io/rafaelvieiras/tinyfin-web   UI included, bundles GPL-2.0 jellyfin-web assets
#   ghcr.io/rafaelvieiras/tinyfin       API only, MIT only
TINYFIN_IMAGE=ghcr.io/rafaelvieiras/tinyfin-web:latest

# Host port that maps to 8096 inside the container.
TINYFIN_PORT=8096

# Absolute path to the media directory you want to catalogue. It is mounted read-only.
# Inside the container it is always /media; add libraries with that path.
TINYFIN_MEDIA_PATH=./media

# Optional. Empty means the scanner catalogues files and does not call TMDB.
TINYFIN_TMDB_API_KEY=

# Scan tuning. Raise the concurrency for a slow remote filesystem.
TINYFIN_SCAN_CONCURRENCY=8
TINYFIN_SCAN_LIBRARY_PARALLELISM=3
