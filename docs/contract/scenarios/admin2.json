[
 {
  "id": "admin.livetv.info",
  "endpoint": "GET /LiveTv/Info",
  "spec": "admin.md#pages",
  "scope": "modern",
  "tags": [
   "admin"
  ],
  "covers": [
   "admin.pages.R1"
  ],
  "requires": [
   "user:alice"
  ],
  "steps": [
   {
    "name": "admin",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/LiveTv/Info"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Services",
       "op": "len",
       "value": 1
      },
      {
       "path": "$.Services[0].Name",
       "op": "eq",
       "value": "Emby"
      },
      {
       "path": "$.Services[0].Tuners",
       "op": "len",
       "value": 0
      },
      {
       "path": "$.IsEnabled",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.EnabledUsers",
       "op": "len",
       "value": 0
      }
     ]
    }
   },
   {
    "name": "non-admin",
    "as": "alice",
    "request": {
     "method": "GET",
     "path": "/LiveTv/Info"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Services",
       "op": "type",
       "value": "array"
      }
     ]
    }
   },
   {
    "name": "anonymous",
    "as": "anonymous",
    "request": {
     "method": "GET",
     "path": "/LiveTv/Info"
    },
    "expect": {
     "status": 401
    }
   }
  ],
  "cleanup": []
 },
