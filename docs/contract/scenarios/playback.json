 {
  "id": "playback.subtitle.encode",
  "endpoint": "POST /Items/{itemId}/PlaybackInfo",
  "spec": "playback.md#subtitle",
  "scope": "modern",
  "tags": [
   "playback"
  ],
  "covers": [
   "playback.subtitle.R1",
   "playback.subtitle.R2"
  ],
  "requires": [
   "library:avtrack",
   "item:av-multi"
  ],
  "steps": [
   {
    "name": "the default subtitle needs Encode: no direct play",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-multi.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.av-multi.id}}"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mkv",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": []
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].DefaultSubtitleStreamIndex",
       "op": "eq",
       "value": 3
      },
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.MediaSources[0].SupportsDirectStream",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.MediaSources[0].SupportsTranscoding",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "SubtitleMethod=Encode"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "SubtitleStreamIndex=3"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "AudioStreamIndex=1"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "TranscodeReasons=SubtitleCodecNotSupported"
      }
     ]
    }
   },
   {
    "name": "a chosen track delivered by Encode",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-multi.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.av-multi.id}}",
      "SubtitleStreamIndex": "4"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mkv",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "vtt",
         "Method": "External"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].DefaultSubtitleStreamIndex",
       "op": "eq",
       "value": 4
      },
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "SubtitleMethod=Encode"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "SubtitleStreamIndex=4"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "TranscodeReasons=SubtitleCodecNotSupported"
      }
     ]
    }
   },
   {
    "name": "audio and subtitle together: both reasons",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-multi.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.av-multi.id}}",
      "AudioStreamIndex": "2",
      "SubtitleStreamIndex": "4"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mkv",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "vtt",
         "Method": "External"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "AudioStreamIndex=2"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "SubtitleMethod=Encode"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "TranscodeReasons=AudioCodecNotSupported,SubtitleCodecNotSupported"
      }
     ]
    }
   },
   {
    "name": "no subtitle (-1) is not burned",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-multi.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.av-multi.id}}",
      "SubtitleStreamIndex": "-1"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mkv",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": []
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].DefaultSubtitleStreamIndex",
       "op": "eq",
       "value": -1
      },
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "absent"
      }
     ]
    }
   }
  ]
 },
 {
