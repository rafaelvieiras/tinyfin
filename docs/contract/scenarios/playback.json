[
 {
  "id": "playback.audio.selection",
  "endpoint": "POST /Items/{itemId}/PlaybackInfo",
  "spec": "playback.md#audio",
  "scope": "modern",
  "tags": [
   "playback"
  ],
  "covers": [
   "playback.audio.R1",
   "playback.audio.R2"
  ],
  "requires": [
   "library:avtrack",
   "item:av-multi"
  ],
  "steps": [
   {
    "name": "no selection: the default track plays directly",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-multi.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.av-multi.id}}"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mkv",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "vtt",
         "Method": "External"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].DefaultAudioStreamIndex",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "absent"
      }
     ]
    }
   },
   {
    "name": "a track the profile takes stays direct play",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-multi.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.av-multi.id}}",
      "AudioStreamIndex": "1"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mkv",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "vtt",
         "Method": "External"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].DefaultAudioStreamIndex",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "absent"
      }
     ]
    }
   },
   {
    "name": "a track the profile does not take is transcoded",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-multi.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.av-multi.id}}",
      "AudioStreamIndex": "2"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mkv",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "vtt",
         "Method": "External"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].DefaultAudioStreamIndex",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.MediaSources[0].SupportsTranscoding",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].TranscodingSubProtocol",
       "op": "eq",
       "value": "hls"
      },
      {
       "path": "$.MediaSources[0].TranscodingContainer",
       "op": "eq",
       "value": "ts"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "master.m3u8?"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "AudioStreamIndex=2"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "TranscodeReasons=AudioCodecNotSupported"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "notcontains",
       "value": "SubtitleMethod"
      }
     ]
    }
   }
  ]
 },
