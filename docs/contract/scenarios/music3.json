[
 {
  "id": "music.mix.song",
  "endpoint": "GET /Items/{itemId}/InstantMix",
  "spec": "music.md",
  "scope": "modern",
  "tags": [
   "music"
  ],
  "covers": [
   "music.mix.R1",
   "music.mix.R2",
   "music.mix.R3"
  ],
  "requires": [
   "library:music",
   "item:mfirst",
   "item:muntagged"
  ],
  "steps": [
   {
    "name": "tracks sharing the genre, the seed included",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mfirst.id}}/InstantMix"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.Items",
       "op": "len",
       "value": 2
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "First Song"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Second Song"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Opening"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Guest Spot"
      }
     ]
    }
   },
   {
    "name": "the songs route is the same",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Songs/{{item.mfirst.id}}/InstantMix"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.Items",
       "op": "len",
       "value": 2
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "First Song"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Second Song"
      }
     ]
    }
   },
   {
    "name": "limit cuts the page, not the total",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mfirst.id}}/InstantMix",
     "query": {
      "limit": "1"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.Items",
       "op": "len",
       "value": 1
      }
     ]
    }
   },
   {
    "name": "a track with no genre mixes every track",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.muntagged.id}}/InstantMix"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 6
      },
      {
       "path": "$.Items",
       "op": "len",
       "value": 6
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "First Song"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Opening"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Embedded Cover"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Guest Spot"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Second Song"
      }
     ]
    }
   },
   {
    "name": "an unknown id",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/00000000000000000000000000000001/InstantMix"
    },
    "expect": {
     "status": 404
    }
   }
  ],
  "cleanup": []
 },
