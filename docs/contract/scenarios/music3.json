       "TranscodingProfiles": [
        {
         "Type": "Audio",
         "Container": "mp3",
         "AudioCodec": "mp3",
         "Protocol": "http",
         "Context": "Streaming"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
