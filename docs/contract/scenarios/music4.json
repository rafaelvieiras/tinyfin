 {
  "id": "music.filter.contributing",
  "endpoint": "GET /Items",
  "spec": "music.md",
  "scope": "modern",
  "tags": [
   "music"
  ],
  "covers": [
   "music.list.R5"
  ],
  "requires": [
   "item:m4artist6",
   "item:m4artist7",
   "item:m4artist8",
   "item:m4compilers"
  ],
  "steps": [
   {
    "name": "an artist that only contributes: the compilation",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "MusicAlbum",
      "ParentId": "{{library.music4.id}}",
      "ContributingArtistIds": "{{item.m4artist6.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items",
       "op": "len",
       "value": 1
      },
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Album Kappa"
      }
     ]
    }
   },
   {
    "name": "its tracks on the compilation",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "Audio",
      "ParentId": "{{library.music4.id}}",
      "ContributingArtistIds": "{{item.m4artist6.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items",
       "op": "len",
       "value": 1
      },
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Kappa One"
      }
     ]
    }
   },
   {
    "name": "another contributor",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "Audio",
      "ParentId": "{{library.music4.id}}",
      "ContributingArtistIds": "{{item.m4artist8.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items",
       "op": "len",
       "value": 1
      },
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Kappa Two"
      }
     ]
    }
   },
   {
    "name": "an album artist that contributes to nothing",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "MusicAlbum",
      "ParentId": "{{library.music4.id}}",
      "ContributingArtistIds": "{{item.m4artist7.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items",
       "op": "len",
       "value": 0
      },
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 0
      }
     ]
    }
   },
   {
    "name": "the compilation's album artist is not a contributor",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "MusicAlbum",
      "ParentId": "{{library.music4.id}}",
      "ContributingArtistIds": "{{item.m4compilers.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items",
       "op": "len",
       "value": 0
      },
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 0
      }
     ]
    }
   },
   {
    "name": "control: ArtistIds lists the artist's own album too",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "MusicAlbum",
      "ParentId": "{{library.music4.id}}",
      "ArtistIds": "{{item.m4artist6.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items",
       "op": "len",
       "value": 2
      },
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Album Eta"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Album Kappa"
      }
     ]
    }
   }
  ]
 },
