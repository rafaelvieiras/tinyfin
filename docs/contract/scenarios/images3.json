[
  {
    "id": "images.frame.extras-movie",
    "endpoint": "GET /Items/{itemId}/Images/{imageType}",
    "spec": "images.md#frames",
    "scope": "modern",
    "tags": [
      "images",
      "extras"
    ],
    "covers": [
      "images.frame.R3"
    ],
    "requires": [
      "item:ex-all",
      "library:extras"
    ],
    "steps": [
      {
        "name": "special features carry a Primary tag",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Items/{{item.ex-all.id}}/SpecialFeatures"
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$[*].ImageTags.Primary",
              "op": "hex32"
            },
            {
              "path": "$[*].ImageBlurHashes.Primary",
              "op": "exists"
            },
            {
              "path": "$[*].PrimaryImageAspectRatio",
              "op": "exists"
            }
          ]
        },
        "capture": {
          "sf": "$[0].Id"
        },
        "retryMs": 30000
      },
      {
        "name": "a special feature: the picture is a JPEG of the video's size",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Items/{{capture.sf}}/Images/Primary"
        },
        "expect": {
          "status": 200,
          "headers": {
            "Content-Type": "/^image\\/jpeg/"
          },
          "image": {
            "width": 320,
            "height": 240
          }
        }
      },
      {
        "name": "a special feature: it is listed with the video's size",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Items/{{capture.sf}}/Images"
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$[?ImageType=Primary].Width",
              "op": "eq",
              "value": 320
            },
            {
              "path": "$[?ImageType=Primary].Height",
              "op": "eq",
              "value": 240
            }
          ]
        }
      },
      {
        "name": "local trailers carry a Primary tag",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Items/{{item.ex-all.id}}/LocalTrailers"
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$[*].ImageTags.Primary",
              "op": "hex32"
            },
            {
              "path": "$[*].ImageBlurHashes.Primary",
              "op": "exists"
            },
            {
              "path": "$[*].PrimaryImageAspectRatio",
              "op": "exists"
            }
          ]
        },
        "capture": {
          "tr": "$[0].Id"
        },
        "retryMs": 30000
      },
      {
        "name": "a trailer: the picture is a JPEG of the video's size",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Items/{{capture.tr}}/Images/Primary"
        },
        "expect": {
          "status": 200,
          "headers": {
            "Content-Type": "/^image\\/jpeg/"
          },
          "image": {
            "width": 320,
            "height": 240
          }
        }
      },
      {
        "name": "a trailer: it is listed with the video's size",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Items/{{capture.tr}}/Images"
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$[?ImageType=Primary].Width",
              "op": "eq",
              "value": 320
            },
            {
              "path": "$[?ImageType=Primary].Height",
              "op": "eq",
              "value": 240
            }
          ]
        }
      },
      {
        "name": "theme videos carry a Primary tag",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Items/{{item.ex-all.id}}/ThemeVideos"
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$.Items[*].ImageTags.Primary",
              "op": "hex32"
            },
            {
              "path": "$.Items[*].ImageBlurHashes.Primary",
              "op": "exists"
            },
            {
              "path": "$.Items[*].PrimaryImageAspectRatio",
              "op": "exists"
            }
          ]
        },
        "capture": {
          "tv": "$.Items[0].Id"
        },
        "retryMs": 30000
      },
      {
        "name": "a theme video: the picture is a JPEG of the video's size",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Items/{{capture.tv}}/Images/Primary"
        },
        "expect": {
          "status": 200,
          "headers": {
            "Content-Type": "/^image\\/jpeg/"
          },
          "image": {
            "width": 320,
            "height": 240
          }
        }
      },
      {
        "name": "a theme video: it is listed with the video's size",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Items/{{capture.tv}}/Images"
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$[?ImageType=Primary].Width",
              "op": "eq",
              "value": 320
            },
            {
              "path": "$[?ImageType=Primary].Height",
              "op": "eq",
              "value": 240
            }
          ]
        }
      },
      {
        "name": "theme songs (audio) get no picture",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Items/{{item.ex-all.id}}/ThemeSongs"
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$.Items[*].ImageTags.Primary",
              "op": "absent"
            }
          ]
        }
      }
    ],
    "cleanup": []
  },
