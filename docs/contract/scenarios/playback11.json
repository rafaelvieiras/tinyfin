[
 {
  "id": "playback.item.stream-flags",
  "endpoint": "GET /Items/{itemId}",
  "spec": "playback.md#item-sources",
  "scope": "modern",
  "tags": [
   "playback",
   "policy"
  ],
  "covers": [
   "playback.item.R1"
  ],
  "requires": [
   "library:avtrack",
   "item:av-multi",
   "library:music",
   "item:mfirst",
   "library:musicvideos",
   "item:mvsecond"
  ],
  "steps": [
   {
    "name": "admin: alpha (video)",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.alpha.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].SupportsDirectStream",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].SupportsTranscoding",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources",
       "op": "len",
       "value": 1
      }
     ]
    }
   },
