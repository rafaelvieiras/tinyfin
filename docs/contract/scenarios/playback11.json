 {
  "id": "playback.encodings.delete",
  "endpoint": "DELETE /Videos/ActiveEncodings",
  "spec": "playback.md#encodings",
  "scope": "modern",
  "tags": [
   "playback",
   "transcode"
  ],
  "covers": [
   "playback.encodings.R1"
  ],
  "requires": [],
  "steps": [
   {
    "name": "anonymous",
    "as": "anonymous",
    "request": {
     "method": "DELETE",
     "path": "/Videos/ActiveEncodings",
     "query": {
      "DeviceId": "d",
      "PlaySessionId": "p"
     },
     "noAuth": true
    },
    "expect": {
     "status": 401
    }
   },
   {
    "name": "both parameters are required",
    "as": "admin",
    "request": {
     "method": "DELETE",
     "path": "/Videos/ActiveEncodings"
    },
    "expect": {
     "status": 400,
     "json": [
      {
       "path": "$.status",
       "op": "eq",
       "value": 400
      },
      {
       "path": "$.errors.deviceId[0]",
       "op": "eq",
       "value": "The deviceId field is required."
      },
      {
       "path": "$.errors.playSessionId[0]",
       "op": "eq",
       "value": "The playSessionId field is required."
      }
     ]
    }
   },
   {
    "name": "the play session is required",
    "as": "admin",
    "request": {
     "method": "DELETE",
     "path": "/Videos/ActiveEncodings",
     "query": {
      "DeviceId": "d"
     }
    },
    "expect": {
     "status": 400,
     "json": [
      {
       "path": "$.errors.playSessionId[0]",
       "op": "eq",
       "value": "The playSessionId field is required."
      },
      {
       "path": "$.errors.deviceId",
       "op": "absent"
      }
     ]
    }
   },
   {
    "name": "the device is required",
    "as": "admin",
    "request": {
     "method": "DELETE",
     "path": "/Videos/ActiveEncodings",
     "query": {
      "PlaySessionId": "p"
     }
    },
    "expect": {
     "status": 400,
     "json": [
      {
       "path": "$.errors.deviceId[0]",
       "op": "eq",
       "value": "The deviceId field is required."
      },
      {
       "path": "$.errors.playSessionId",
       "op": "absent"
      }
     ]
    }
   },
   {
    "name": "blank values are missing ones",
    "as": "admin",
    "request": {
     "method": "DELETE",
     "path": "/Videos/ActiveEncodings",
     "query": {
      "DeviceId": " ",
      "PlaySessionId": "p"
     }
    },
    "expect": {
     "status": 400,
     "json": [
      {
       "path": "$.errors.deviceId[0]",
       "op": "eq",
       "value": "The deviceId field is required."
      }
     ]
    }
   },
   {
    "name": "a session with no encode",
    "as": "admin",
    "request": {
     "method": "DELETE",
     "path": "/Videos/ActiveEncodings",
     "query": {
      "DeviceId": "d",
      "PlaySessionId": "enc-none-{{run.suffix}}"
     }
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "again",
    "as": "admin",
    "request": {
     "method": "DELETE",
     "path": "/Videos/ActiveEncodings",
     "query": {
      "DeviceId": "d",
      "PlaySessionId": "enc-none-{{run.suffix}}"
     }
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "parameter names ignore case",
    "as": "admin",
    "request": {
     "method": "DELETE",
     "path": "/Videos/ActiveEncodings?deviceid=d&PLAYSESSIONID=enc-none-{{run.suffix}}"
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "any user may stop a session",
    "as": "alice",
    "request": {
     "method": "DELETE",
     "path": "/Videos/ActiveEncodings",
     "query": {
      "DeviceId": "d",
      "PlaySessionId": "enc-none-{{run.suffix}}"
     }
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "a get is not a route",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Videos/ActiveEncodings",
     "query": {
      "DeviceId": "d",
      "PlaySessionId": "p"
     }
    },
    "expect": {
     "status": 405
    }
   }
  ]
 },
 {
  "id": "playback.encodings.restart",
  "endpoint": "DELETE /Videos/ActiveEncodings",
  "spec": "playback.md#encodings",
  "scope": "modern",
  "tags": [
   "playback",
   "transcode"
  ],
  "covers": [
   "playback.encodings.R1",
   "playback.encodings.R2"
  ],
  "requires": [
   "library:hls3",
   "item:alpha"
  ],
  "steps": [
   {
    "name": "an encode of the session",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Videos/{{item.alpha.id}}/hls1/main/0.ts?MediaSourceId={{item.alpha.id}}&DeviceId=encdev&SegmentContainer=ts&SegmentLength=6&VideoCodec=h264&AudioCodec=aac&MaxWidth=160&PlaySessionId=enc-{{run.suffix}}&runtimeTicks=0&actualSegmentLengthTicks=60000000"
    },
    "expect": {
     "status": 200,
     "headers": {
      "Content-Type": "video/mp2t"
     },
     "text": [
      {
       "op": "matches",
       "value": "(?s)^G"
      }
     ]
    }
   },
   {
    "name": "stop it",
    "as": "admin",
    "request": {
     "method": "DELETE",
     "path": "/Videos/ActiveEncodings",
     "query": {
      "DeviceId": "encdev",
      "PlaySessionId": "enc-{{run.suffix}}"
     }
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "the same segment starts a new encode",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Videos/{{item.alpha.id}}/hls1/main/0.ts?MediaSourceId={{item.alpha.id}}&DeviceId=encdev&SegmentContainer=ts&SegmentLength=6&VideoCodec=h264&AudioCodec=aac&MaxWidth=160&PlaySessionId=enc-{{run.suffix}}&runtimeTicks=0&actualSegmentLengthTicks=60000000"
    },
    "expect": {
     "status": 200,
     "headers": {
      "Content-Type": "video/mp2t"
     },
     "text": [
      {
       "op": "matches",
       "value": "(?s)^G"
      }
     ]
    }
   },
   {
    "name": "the device does not matter",
    "as": "admin",
    "request": {
     "method": "DELETE",
     "path": "/Videos/ActiveEncodings",
     "query": {
      "DeviceId": "encother",
      "PlaySessionId": "enc-{{run.suffix}}"
     }
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "a segment further on after the stop",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Videos/{{item.alpha.id}}/hls1/main/1.ts?MediaSourceId={{item.alpha.id}}&DeviceId=encdev&SegmentContainer=ts&SegmentLength=6&VideoCodec=h264&AudioCodec=aac&MaxWidth=160&PlaySessionId=enc-{{run.suffix}}&runtimeTicks=0&actualSegmentLengthTicks=60000000"
    },
    "expect": {
     "status": 200,
     "headers": {
      "Content-Type": "video/mp2t"
     },
     "text": [
      {
       "op": "matches",
       "value": "(?s)^G"
      }
     ]
    }
   },
   {
    "name": "the case of the session does not matter",
    "as": "admin",
    "request": {
     "method": "DELETE",
     "path": "/Videos/ActiveEncodings",
     "query": {
      "DeviceId": "encdev",
      "PlaySessionId": "ENC-{{run.suffix}}"
     }
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "and again",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Videos/{{item.alpha.id}}/hls1/main/0.ts?MediaSourceId={{item.alpha.id}}&DeviceId=encdev&SegmentContainer=ts&SegmentLength=6&VideoCodec=h264&AudioCodec=aac&MaxWidth=160&PlaySessionId=enc-{{run.suffix}}&runtimeTicks=0&actualSegmentLengthTicks=60000000"
    },
    "expect": {
     "status": 200,
     "headers": {
      "Content-Type": "video/mp2t"
     },
     "text": [
      {
       "op": "matches",
       "value": "(?s)^G"
      }
     ]
    }
   },
   {
    "name": "a session that is not running leaves it",
    "as": "admin",
    "request": {
     "method": "DELETE",
     "path": "/Videos/ActiveEncodings",
     "query": {
      "DeviceId": "encdev",
      "PlaySessionId": "enc-other-{{run.suffix}}"
     }
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "still served",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Videos/{{item.alpha.id}}/hls1/main/1.ts?MediaSourceId={{item.alpha.id}}&DeviceId=encdev&SegmentContainer=ts&SegmentLength=6&VideoCodec=h264&AudioCodec=aac&MaxWidth=160&PlaySessionId=enc-{{run.suffix}}&runtimeTicks=0&actualSegmentLengthTicks=60000000"
    },
    "expect": {
     "status": 200,
     "headers": {
      "Content-Type": "video/mp2t"
     },
     "text": [
      {
       "op": "matches",
       "value": "(?s)^G"
      }
     ]
    }
   },
   {
    "name": "finally stop it",
    "as": "admin",
    "request": {
     "method": "DELETE",
     "path": "/Videos/ActiveEncodings",
     "query": {
      "DeviceId": "encdev",
      "PlaySessionId": "enc-{{run.suffix}}"
     }
    },
    "expect": {
     "status": 204
    }
   }
  ]
 },
