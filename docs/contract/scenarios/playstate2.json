[
  {
    "id": "playstate.session.transcoding-info-lifecycle",
    "endpoint": "GET /Sessions",
    "spec": "playstate.md#session-state",
    "scope": "modern",
    "tags": [
      "playstate",
      "transcode",
      "web-client"
    ],
    "covers": [
      "playstate.session.R10",
      "playstate.session.R11",
      "playstate.session.R12",
      "playstate.session.R13"
    ],
    "requires": [
      "library:avtrack",
      "item:av-multi"
    ],
    "steps": [
      {
        "name": "register the session",
        "as": "admin",
        "request": {
          "method": "POST",
          "path": "/Sessions/Capabilities/Full",
          "body": {
            "PlayableMediaTypes": [
              "Video"
            ],
            "SupportedCommands": []
          }
        },
        "expect": {
          "status": 204
        }
      },
      {
        "name": "reset: a playing report that is not a transcode",
        "as": "admin",
        "request": {
          "method": "POST",
          "path": "/Sessions/Playing",
          "body": {
            "ItemId": "{{item.av-multi.id}}",
            "PlaySessionId": "sc-tinfo-reset",
            "PlayMethod": "DirectPlay",
            "IsPaused": true
          }
        },
        "expect": {
          "status": 204
        }
      },
      {
        "name": "reset: stopped",
        "as": "admin",
        "request": {
          "method": "POST",
          "path": "/Sessions/Playing/Stopped",
          "body": {
            "ItemId": "{{item.av-multi.id}}",
            "PlaySessionId": "sc-tinfo-reset"
          }
        },
        "expect": {
          "status": 204
        }
      },
      {
        "name": "no stream yet: no TranscodingInfo",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Sessions",
          "query": {
            "deviceId": "{{device.admin}}"
          }
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$[0].TranscodingInfo",
              "op": "absent"
            }
          ]
        }
      },
      {
        "name": "first segment starts the transcode",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Videos/{{item.av-multi.id}}/hls1/main/0.ts?MediaSourceId={{item.av-multi.id}}&PlaySessionId=sc-tinfo&DeviceId={{device.admin}}&SegmentContainer=ts&SegmentLength=3&VideoCodec=h264&AudioCodec=aac&MaxWidth=160&VideoBitrate=500000&TranscodeReasons=ContainerBitrateExceedsLimit&runtimeTicks=0&actualSegmentLengthTicks=30000000"
        },
        "expect": {
          "status": 200
        }
      },
      {
        "name": "the session describes the stream, even with nothing playing",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Sessions",
          "query": {
            "deviceId": "{{device.admin}}"
          }
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$[0].NowPlayingItem",
              "op": "absent"
            },
            {
              "path": "$[0].TranscodingInfo.VideoCodec",
              "op": "eq",
              "value": "h264"
            },
            {
              "path": "$[0].TranscodingInfo.AudioCodec",
              "op": "eq",
              "value": "aac"
            },
            {
              "path": "$[0].TranscodingInfo.Container",
              "op": "eq",
              "value": "ts"
            },
            {
              "path": "$[0].TranscodingInfo.IsVideoDirect",
              "op": "eq",
              "value": false
            },
            {
              "path": "$[0].TranscodingInfo.IsAudioDirect",
              "op": "eq",
              "value": true
            },
            {
              "path": "$[0].TranscodingInfo.Bitrate",
              "op": "eq",
              "value": 628000
            },
            {
              "path": "$[0].TranscodingInfo.Width",
              "op": "eq",
              "value": 160
            },
            {
              "path": "$[0].TranscodingInfo.Height",
              "op": "eq",
              "value": 120
            },
            {
              "path": "$[0].TranscodingInfo.AudioChannels",
              "op": "eq",
              "value": 1
            },
            {
              "path": "$[0].TranscodingInfo.HardwareAccelerationType",
              "op": "eq",
              "value": "none"
            },
            {
              "path": "$[0].TranscodingInfo.TranscodeReasons",
              "op": "eq",
              "value": [
                "ContainerBitrateExceedsLimit"
              ]
            }
          ]
        }
      },
      {
        "name": "start reported as Transcode",
        "as": "admin",
        "request": {
          "method": "POST",
          "path": "/Sessions/Playing",
          "body": {
            "ItemId": "{{item.av-multi.id}}",
            "PlaySessionId": "sc-tinfo",
            "PlayMethod": "Transcode",
            "IsPaused": true,
            "PositionTicks": 0
          }
        },
        "expect": {
          "status": 204
        }
      },
      {
        "name": "Transcode is kept while the stream runs",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Sessions",
          "query": {
            "deviceId": "{{device.admin}}"
          }
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$[0].PlayState.PlayMethod",
              "op": "eq",
              "value": "Transcode"
            },
            {
              "path": "$[0].TranscodingInfo.VideoCodec",
              "op": "eq",
              "value": "h264"
            }
          ]
        }
      },
      {
        "name": "progress reported as DirectStream",
        "as": "admin",
        "request": {
          "method": "POST",
          "path": "/Sessions/Playing/Progress",
          "body": {
            "ItemId": "{{item.av-multi.id}}",
            "PlaySessionId": "sc-tinfo",
            "PlayMethod": "DirectStream",
            "IsPaused": true,
            "PositionTicks": 10000000
          }
        },
        "expect": {
          "status": 204
        }
      },
      {
        "name": "a report that is not Transcode hides TranscodingInfo",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Sessions",
          "query": {
            "deviceId": "{{device.admin}}"
          }
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$[0].PlayState.PlayMethod",
              "op": "eq",
              "value": "DirectStream"
            },
            {
              "path": "$[0].TranscodingInfo",
              "op": "absent"
            }
          ]
        }
      },
      {
        "name": "progress reported as Transcode again",
        "as": "admin",
        "request": {
          "method": "POST",
          "path": "/Sessions/Playing/Progress",
          "body": {
            "ItemId": "{{item.av-multi.id}}",
            "PlaySessionId": "sc-tinfo",
            "PlayMethod": "Transcode",
            "IsPaused": true,
            "PositionTicks": 20000000
          }
        },
        "expect": {
          "status": 204
        }
      },
      {
        "name": "the stream still runs, the info stays hidden",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Sessions",
          "query": {
            "deviceId": "{{device.admin}}"
          }
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$[0].PlayState.PlayMethod",
              "op": "eq",
              "value": "Transcode"
            },
            {
              "path": "$[0].TranscodingInfo",
              "op": "absent"
            }
          ]
        }
      }
    ],
    "cleanup": [
      {
        "name": "cleanup: close playback",
        "as": "admin",
        "request": {
          "method": "POST",
          "path": "/Sessions/Playing/Stopped",
          "body": {
            "ItemId": "{{item.av-multi.id}}",
            "PlaySessionId": "sc-tinfo",
            "Failed": true
          }
        },
        "expect": {
          "status": 204
        }
      }
    ]
  },
