  },
  {
    "id": "playstate.session.transcoding-info-copy-and-mp4",
    "endpoint": "GET /Sessions",
    "spec": "playstate.md#session-state",
    "scope": "modern",
    "tags": [
      "playstate",
      "transcode"
    ],
    "covers": [
      "playstate.session.R14",
      "playstate.session.R15"
    ],
    "requires": [
      "library:long",
      "item:long"
    ],
    "steps": [
      {
        "name": "register the session",
        "as": "admin",
        "request": {
          "method": "POST",
          "path": "/Sessions/Capabilities/Full",
          "body": {
            "PlayableMediaTypes": [
              "Video"
            ],
            "SupportedCommands": []
          }
        },
        "expect": {
          "status": 204
        }
      },
      {
        "name": "reset: a playing report that is not a transcode",
        "as": "admin",
        "request": {
          "method": "POST",
          "path": "/Sessions/Playing",
          "body": {
            "ItemId": "{{item.long.id}}",
            "PlaySessionId": "sc-tinfo-reset",
            "PlayMethod": "DirectPlay",
            "IsPaused": true
          }
        },
        "expect": {
          "status": 204
        }
      },
      {
        "name": "reset: stopped",
        "as": "admin",
        "request": {
          "method": "POST",
          "path": "/Sessions/Playing/Stopped",
          "body": {
            "ItemId": "{{item.long.id}}",
            "PlaySessionId": "sc-tinfo-reset"
          }
        },
        "expect": {
          "status": 204
        }
      },
      {
        "name": "a copied picture",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Videos/{{item.long.id}}/hls1/main/0.ts?MediaSourceId={{item.long.id}}&PlaySessionId=sc-tinfo&DeviceId={{device.admin}}&SegmentContainer=ts&SegmentLength=3&VideoCodec=h264&AudioCodec=aac&VideoBitrate=500000&runtimeTicks=0&actualSegmentLengthTicks=30000000"
        },
        "expect": {
          "status": 200
        }
      },
      {
        "name": "IsVideoDirect, the source size, the rate counted for the variant",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Sessions",
          "query": {
            "deviceId": "{{device.admin}}"
          }
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$[0].TranscodingInfo.VideoCodec",
              "op": "eq",
              "value": "h264"
            },
            {
              "path": "$[0].TranscodingInfo.IsVideoDirect",
              "op": "eq",
              "value": true
            },
            {
              "path": "$[0].TranscodingInfo.IsAudioDirect",
              "op": "eq",
              "value": true
            },
            {
              "path": "$[0].TranscodingInfo.Width",
              "op": "eq",
              "value": 320
            },
            {
              "path": "$[0].TranscodingInfo.Height",
              "op": "eq",
              "value": 240
            },
            {
              "path": "$[0].TranscodingInfo.Bitrate",
              "op": "eq",
              "value": 547500
            },
            {
              "path": "$[0].TranscodingInfo.TranscodeReasons",
              "op": "eq",
              "value": []
            }
          ]
        }
      },
      {
        "name": "an encoded picture in fragmented mp4",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Videos/{{item.long.id}}/hls1/main/0.mp4?MediaSourceId={{item.long.id}}&PlaySessionId=sc-tinfo&DeviceId={{device.admin}}&SegmentContainer=mp4&SegmentLength=3&VideoCodec=h264&AudioCodec=aac&MaxWidth=160&VideoBitrate=500000&runtimeTicks=0&actualSegmentLengthTicks=30000000"
        },
