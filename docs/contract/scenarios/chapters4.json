 {
  "id": "chapters.images.zero-side",
  "endpoint": "GET /Items/{itemId}/Images/Chapter/{imageIndex}",
  "spec": "chapters.md#images",
  "scope": "modern",
  "tags": [
   "chapters",
   "chapter-images"
  ],
  "covers": [
   "chapters.images.R6",
   "chapters.images.R8"
  ],
  "requires": [
   "library:chapterimg3",
   "item:chapter-noise",
   "item:chapter-portrait",
   "item:chapter-small"
  ],
  "steps": [
   {
    "name": "wait for the pictures",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.chapter-small.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Chapters[1].ImageTag",
       "op": "matches",
       "value": "^[0-9a-f]{32}$"
      }
     ]
    },
    "retryMs": 30000
   },
   {
    "name": "a side that rounds to nothing leaves the picture (width=640 height=54 maxWidth=5): as it is",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.chapter-noise.id}}/Images/Chapter/0",
     "query": {
      "width": "640",
      "height": "54",
      "maxWidth": "5"
     }
    },
    "expect": {
     "status": 200,
     "headers": {
      "Content-Type": "image/jpeg"
     },
     "text": [
      {
       "op": "contains",
       "value": "Lavc"
      }
     ]
    }
   },
   {
    "name": "a side that rounds to nothing leaves the picture (width=62 maxWidth=1 maxHeight=1): as it is",
