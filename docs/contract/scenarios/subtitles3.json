[
 {
  "id": "subtitles3.burn.fonts",
  "endpoint": "GET /Videos/{itemId}/hls1/{playlistId}/{segmentId}.{container}",
  "spec": "bitmap.md#burnin",
  "scope": "modern",
  "tags": [
   "subtitles",
   "transcode"
  ],
  "covers": [
   "bitmap.burnin.R4",
   "bitmap.burnin.R6"
  ],
  "requires": [
   "library:subs3",
   "item:font-missing",
   "item:font-arial",
   "item:font-serif",
   "item:font-attach"
  ],
  "steps": [
   {
    "name": "an ASS style font that is not installed falls back",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Videos/{{item.font-missing.id}}/hls1/main/0.ts?MediaSourceId={{item.font-missing.id}}&DeviceId=conf&SegmentContainer=ts&SegmentLength=6&VideoCodec=h264&AudioCodec=aac&AudioStreamIndex=1&SubtitleStreamIndex=0&SubtitleMethod=Encode&VideoBitrate=500000&PlaySessionId=s3-{{run.suffix}}-font-missing&runtimeTicks=0&actualSegmentLengthTicks=40000000"
    },
    "expect": {
     "status": 200,
     "headers": {
      "Content-Type": "video/mp2t"
     },
     "text": [
      {
       "op": "matches",
       "value": "(?s)^.{900,}$"
      }
     ]
    }
   },
   {
    "name": "a style font of Arial",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Videos/{{item.font-arial.id}}/hls1/main/0.ts?MediaSourceId={{item.font-arial.id}}&DeviceId=conf&SegmentContainer=ts&SegmentLength=6&VideoCodec=h264&AudioCodec=aac&AudioStreamIndex=1&SubtitleStreamIndex=0&SubtitleMethod=Encode&VideoBitrate=500000&PlaySessionId=s3-{{run.suffix}}-font-arial&runtimeTicks=0&actualSegmentLengthTicks=40000000"
    },
    "expect": {
     "status": 200,
     "headers": {
      "Content-Type": "video/mp2t"
     },
     "text": [
      {
       "op": "matches",
       "value": "(?s)^.{900,}$"
      }
     ]
    }
   },
   {
    "name": "a style font of Times New Roman",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Videos/{{item.font-serif.id}}/hls1/main/0.ts?MediaSourceId={{item.font-serif.id}}&DeviceId=conf&SegmentContainer=ts&SegmentLength=6&VideoCodec=h264&AudioCodec=aac&AudioStreamIndex=1&SubtitleStreamIndex=0&SubtitleMethod=Encode&VideoBitrate=500000&PlaySessionId=s3-{{run.suffix}}-font-serif&runtimeTicks=0&actualSegmentLengthTicks=40000000"
    },
    "expect": {
     "status": 200,
     "headers": {
      "Content-Type": "video/mp2t"
     },
     "text": [
      {
       "op": "matches",
       "value": "(?s)^.{900,}$"
      }
     ]
    }
   },
   {
    "name": "an embedded track whose font is attached to the file",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Videos/{{item.font-attach.id}}/hls1/main/0.ts?MediaSourceId={{item.font-attach.id}}&DeviceId=conf&SegmentContainer=ts&SegmentLength=6&VideoCodec=h264&AudioCodec=aac&AudioStreamIndex=1&SubtitleStreamIndex=2&SubtitleMethod=Encode&VideoBitrate=500000&PlaySessionId=s3-{{run.suffix}}-font-attach&runtimeTicks=0&actualSegmentLengthTicks=40000000"
    },
    "expect": {
     "status": 200,
     "headers": {
      "Content-Type": "video/mp2t"
     },
     "text": [
      {
       "op": "matches",
       "value": "(?s)^.{900,}$"
      }
     ]
    }
   }
  ]
 },
