 },
 {
  "id": "images.local.shared-folder",
  "endpoint": "GET /Items/{itemId}/Images",
  "spec": "images.md#shared",
  "scope": "modern",
  "tags": [
   "images"
  ],
  "covers": [
   "images.shared.R1",
   "images.shared.R2"
  ],
  "requires": [
   "item:art-multi-one",
   "item:art-multi-two",
   "item:art-multi-folder",
   "library:art"
  ],
  "steps": [
   {
    "name": "a movie takes only its own pictures",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.art-multi-one.id}}/Images"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[?ImageType=Primary].Path",
       "op": "matches",
       "value": "Multi One \\(2207\\)-poster\\.jpg$"
      },
      {
       "path": "$[?ImageType=Thumb].Path",
       "op": "matches",
       "value": "Multi One \\(2207\\)-landscape\\.jpg$"
      },
      {
       "path": "$[?ImageType=Backdrop].Path",
       "op": "absent"
      }
     ]
    }
   },
   {
    "name": "the other movie has its own backdrop only",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.art-multi-two.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.BackdropImageTags",
       "op": "len",
       "value": 1
      }
     ]
    }
   },
   {
    "name": "the folder item has the folder's pictures",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.art-multi-folder.id}}/Images"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[?ImageType=Primary].Path",
       "op": "matches",
       "value": "Art Multi/poster\\.jpg$"
      },
      {
       "path": "$[?ImageType=Backdrop].Path",
       "op": "matches",
       "value": "Art Multi/fanart\\.jpg$"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "images.local.folder-shaped",
  "endpoint": "GET /Items/{itemId}/Images",
  "spec": "images.md#shape",
  "scope": "modern",
  "tags": [
   "images"
  ],
  "covers": [
   "images.shape.R1"
  ],
  "requires": [
   "item:art-sub",
   "item:art-sub-folder",
   "library:art"
  ],
  "steps": [
   {
    "name": "the folder item has the pictures",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.art-sub-folder.id}}/Images"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[?ImageType=Primary].Path",
       "op": "matches",
       "value": "poster\\.jpg$"
      },
      {
       "path": "$[?ImageType=Logo].Path",
       "op": "matches",
       "value": "logo\\.png$"
      }
     ]
    }
   },
   {
    "name": "and so has the movie that is alone in it",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.art-sub.id}}/Images"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[?ImageType=Primary].Path",
       "op": "matches",
       "value": "Art Sub \\(2208\\)/poster\\.jpg$"
      },
      {
       "path": "$[?ImageType=Logo].Path",
       "op": "matches",
       "value": "Art Sub \\(2208\\)/logo\\.png$"
      }
     ]
    }
   },
   {
    "name": "the folder holds the movie and its sub folder",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.art-sub-folder.id}}",
     "query": {
      "Fields": "ChildCount"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Type",
       "op": "eq",
       "value": "Folder"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "images.series.names",
