       "value": "clearart\\.jpg$"
      },
      {
       "path": "$[?ImageType=Banner].Path",
       "op": "matches",
       "value": "banner\\.jpg$"
      },
      {
       "path": "$[?ImageType=Thumb].Path",
       "op": "matches",
       "value": "landscape\\.jpg$"
      },
      {
       "path": "$[?ImageIndex=0].Path",
