 {
  "id": "images.api.index-lookup",
  "endpoint": "GET /Items/{itemId}/Images/{imageType}/{imageIndex}",
  "spec": "images.md#api",
  "scope": "modern",
  "tags": [
   "images"
  ],
  "covers": [
   "images.api.R2",
   "images.api.R3"
  ],
  "requires": [
   "item:art-backdrops",
   "library:art"
  ],
  "steps": [
   {
    "name": "read the tag",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.art-backdrops.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.BackdropImageTags[0]",
       "op": "hex32"
      }
     ]
    },
    "capture": {
     "tag": "$.BackdropImageTags[0]"
    }
   },
   {
    "name": "the last backdrop",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.art-backdrops.id}}/Images/Backdrop/7"
    },
    "expect": {
     "status": 200,
     "headers": {
      "Content-Type": "/^image\\//"
     }
    }
   },
   {
    "name": "no such index",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.art-backdrops.id}}/Images/Backdrop/8"
    },
    "expect": {
     "status": 404
    }
   },
   {
    "name": "not a number",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.art-backdrops.id}}/Images/Backdrop/abc"
    },
    "expect": {
     "status": 400
    }
   },
   {
    "name": "a single image has no index 1",
    "as": "admin",
    "request": {
     "method": "GET",
