[
 {
  "id": "images.local.primary-priority",
  "endpoint": "GET /Items/{itemId}/Images",
  "spec": "images.md#names",
  "scope": "modern",
  "tags": [
   "images"
  ],
  "covers": [
   "images.names.R2"
  ],
  "requires": [
   "item:art-primary",
   "library:art"
  ],
  "steps": [
   {
    "name": "a movie's own '<video>-poster' beats poster, folder and cover",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.art-primary.id}}/Images"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[?ImageType=Primary].Path",
       "op": "matches",
       "value": "Art Primary \\(2201\\)-poster\\.webp$"
      }
     ]
    }
   },
   {
    "name": "the item advertises it",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.art-primary.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.ImageTags.Primary",
       "op": "hex32"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "images.local.extension-order",
  "endpoint": "GET /Items/{itemId}/Images",
  "spec": "images.md#names",
  "scope": "modern",
  "tags": [
   "images"
  ],
  "covers": [
   "images.names.R1"
  ],
  "requires": [
   "item:art-extorder",
   "library:art"
  ],
  "steps": [
   {
    "name": "png beats jpg and webp for one name",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.art-extorder.id}}/Images"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[?ImageType=Primary].Path",
       "op": "matches",
       "value": "poster\\.png$"
      },
      {
       "path": "$[?ImageType=Backdrop].Path",
       "op": "matches",
       "value": "fanart\\.png$"
      }
     ]
    }
   },
   {
    "name": "one name is one backdrop",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.art-extorder.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.BackdropImageTags",
       "op": "len",
       "value": 1
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "images.local.extensions-recognized",
  "endpoint": "GET /Items/{itemId}/Images",
  "spec": "images.md#names",
  "scope": "modern",
  "tags": [
   "images"
  ],
  "covers": [
   "images.names.R1"
  ],
  "requires": [
   "item:art-extok",
   "library:art"
  ],
  "steps": [
   {
    "name": "tbn, webp, jpeg and gif pictures, in any case, are artwork",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.art-extok.id}}/Images"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[?ImageType=Primary].Path",
       "op": "matches",
       "value": "POSTER\\.TBN$"
      },
      {
       "path": "$[?ImageType=Logo].Path",
       "op": "matches",
       "value": "logo\\.jpeg$"
      },
      {
       "path": "$[?ImageType=Banner].Path",
       "op": "matches",
       "value": "Banner\\.GIF$"
      },
      {
       "path": "$[?ImageType=Backdrop].Path",
       "op": "matches",
       "value": "Fanart\\.webp$"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "images.local.extensions-ignored",
  "endpoint": "GET /Items/{itemId}",
  "spec": "images.md#names",
  "scope": "modern",
  "tags": [
   "images"
  ],
  "covers": [
   "images.names.R1"
  ],
  "requires": [
   "item:art-extno",
   "library:art"
  ],
  "steps": [
   {
    "name": "avif, bmp, heic and jpe pictures are not artwork",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.art-extno.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.ImageTags.Logo",
       "op": "absent"
      },
      {
       "path": "$.ImageTags.Banner",
       "op": "absent"
      },
      {
       "path": "$.BackdropImageTags",
       "op": "len",
       "value": 0
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "images.local.kinds",
  "endpoint": "GET /Items/{itemId}/Images",
  "spec": "images.md#names",
  "scope": "modern",
  "tags": [
   "images"
  ],
  "covers": [
   "images.names.R3",
   "images.names.R4",
   "images.api.R1"
  ],
  "requires": [
   "item:art-kinds",
   "library:art"
  ],
  "steps": [
   {
    "name": "each kind takes the first of its names",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.art-kinds.id}}/Images"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[?ImageType=Logo].Path",
       "op": "matches",
       "value": "clearlogo\\.png$"
      },
      {
       "path": "$[?ImageType=Art].Path",
       "op": "matches",
       "value": "clearart\\.jpg$"
      },
      {
       "path": "$[?ImageType=Banner].Path",
       "op": "matches",
       "value": "banner\\.jpg$"
      },
      {
       "path": "$[?ImageType=Thumb].Path",
       "op": "matches",
       "value": "landscape\\.jpg$"
      },
      {
       "path": "$[?ImageType=Disc].Path",
       "op": "matches",
       "value": "cdart\\.jpg$"
      },
      {
       "path": "$[?ImageType=Box].Path",
       "op": "absent"
      },
      {
       "path": "$[?ImageType=Screenshot].Path",
       "op": "absent"
      },
      {
       "path": "$[?ImageType=Menu].Path",
       "op": "absent"
      },
      {
       "path": "$[?ImageType=BoxRear].Path",
       "op": "absent"
      }
     ]
    }
   },
   {
    "name": "the item carries a tag per kind",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.art-kinds.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.ImageTags.Logo",
       "op": "hex32"
      },
      {
       "path": "$.ImageTags.Art",
       "op": "hex32"
      },
      {
       "path": "$.ImageTags.Banner",
       "op": "hex32"
      },
      {
       "path": "$.ImageTags.Thumb",
       "op": "hex32"
      },
      {
       "path": "$.ImageTags.Disc",
       "op": "hex32"
      },
      {
       "path": "$.ImageTags.Box",
       "op": "absent"
      },
      {
       "path": "$.ImageTags.Screenshot",
       "op": "absent"
      },
      {
       "path": "$.ImageTags.Menu",
       "op": "absent"
      },
      {
       "path": "$.ImageBlurHashes.Logo",
       "op": "exists"
      },
      {
       "path": "$.ImageBlurHashes.Banner",
       "op": "exists"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "images.local.backdrops",
  "endpoint": "GET /Items/{itemId}",
  "spec": "images.md#backdrops",
  "scope": "modern",
  "tags": [
   "images"
  ],
  "covers": [
   "images.backdrop.R1"
  ],
  "requires": [
   "item:art-backdrops",
   "library:art"
  ],
  "steps": [
   {
    "name": "every recognized backdrop is listed: fanart, fanart-1, fanart-2, background, art, extrafanart/a, extrafanart/b, backdrop1",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.art-backdrops.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.BackdropImageTags",
       "op": "len",
       "value": 8
      },
      {
       "path": "$.BackdropImageTags[0]",
       "op": "hex32"
      },
      {
       "path": "$.BackdropImageTags[7]",
       "op": "hex32"
      },
      {
       "path": "$.ImageBlurHashes.Backdrop",
       "op": "exists"
      }
     ]
    }
   },
   {
    "name": "all eight are served",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.art-backdrops.id}}/Images/Backdrop/7"
    },
    "expect": {
     "status": 200
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "images.local.backdrop-duplicate",
