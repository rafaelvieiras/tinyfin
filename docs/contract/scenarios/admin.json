 {
  "id": "admin.logs.file",
  "endpoint": "GET /System/Logs/Log",
  "spec": "admin.md#logs",
  "scope": "modern",
  "tags": [
   "admin"
  ],
  "covers": [
   "admin.logs.R2",
   "admin.logs.R3"
  ],
  "requires": [
   "user:alice"
  ],
  "steps": [
   {
    "name": "names",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/System/Logs"
    },
    "expect": {
     "status": 200
    },
    "capture": {
     "log": "$[0].Name"
    }
   },
   {
    "name": "read",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/System/Logs/Log?name={{capture.log}}"
    },
    "expect": {
     "status": 200
    }
   },
   {
    "name": "unknown name",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/System/Logs/Log?name=nope.log"
    },
    "expect": {
     "status": 404
    }
   },
   {
    "name": "path traversal",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/System/Logs/Log?name=..%2Fx.log"
    },
    "expect": {
     "status": 404
    }
   },
   {
    "name": "non-admin",
    "as": "alice",
    "request": {
     "method": "GET",
     "path": "/System/Logs"
    },
    "expect": {
     "status": 403
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "admin.backup.create",
  "endpoint": "POST /Backup/Create",
  "spec": "admin.md#backup",
  "scope": "modern",
  "tags": [
   "admin"
  ],
  "covers": [
   "admin.backup.R1",
   "admin.backup.R2",
   "admin.backup.R3"
  ],
  "requires": [
   "user:alice"
  ],
  "steps": [
   {
    "sleepMs": 6000
   },
   {
    "name": "create",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Backup/Create",
     "body": {
      "Database": true,
      "Metadata": false
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Path",
       "op": "matches",
       "value": "\\.zip$"
      },
      {
       "path": "$.Options.Database",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.ServerVersion",
       "op": "exists"
      },
      {
       "path": "$.DateCreated",
       "op": "exists"
      }
     ]
    },
    "capture": {
     "p": "$.Path"
    }
   },
   {
    "name": "listed",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Backup"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[*].Path",
       "op": "contains",
       "value": "{{capture.p}}"
      }
     ]
    }
   },
   {
    "name": "manifest",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Backup/Manifest?path={{capture.p}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Path",
       "op": "eq",
       "value": "{{capture.p}}"
      },
      {
       "path": "$.Options.Database",
       "op": "eq",
       "value": true
      }
     ]
    }
   },
   {
    "name": "unknown manifest",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Backup/Manifest?path=nope.zip"
    },
    "expect": {
     "status": 404
    }
   },
   {
    "name": "non-admin",
    "as": "alice",
    "request": {
     "method": "GET",
     "path": "/Backup"
    },
    "expect": {
     "status": 403
    }
   }
  ],
  "cleanup": []
 },
