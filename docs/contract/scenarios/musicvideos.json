  "steps": [
   {
    "name": "a profile that cannot play it gets a transcode",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.mvsecond.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.mvsecond.id}}"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "webm",
         "Type": "Video",
         "VideoCodec": "vp9",
         "AudioCodec": "opus"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.MediaSources[0].SupportsTranscoding",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].TranscodingSubProtocol",
       "op": "eq",
       "value": "hls"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "matches",
       "value": "(?i)master\\.m3u8"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "musicvideos.playstate",
  "endpoint": "POST /UserPlayedItems/{itemId}",
  "spec": "musicvideos.md",
  "scope": "modern",
  "tags": [
   "musicvideos"
  ],
  "covers": [
   "musicvideos.playstate.R1"
  ],
  "requires": [
   "library:musicvideos",
   "item:mvplain"
  ],
  "steps": [
   {
    "name": "a clip can be marked played",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/UserPlayedItems/{{item.mvplain.id}}",
     "query": {
      "userId": "{{user.admin.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Played",
       "op": "eq",
       "value": true
      }
     ]
    }
   },
   {
    "name": "and shows it",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mvplain.id}}",
     "query": {
      "userId": "{{user.admin.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.UserData.Played",
       "op": "eq",
       "value": true
      }
     ]
    }
   },
   {
    "name": "as a favorite",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/UserFavoriteItems/{{item.mvplain.id}}",
     "query": {
      "userId": "{{user.admin.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.IsFavorite",
       "op": "eq",
       "value": true
      }
     ]
    }
   },
   {
    "name": "the favorite filter finds it",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "MusicVideo",
      "SortBy": "SortName",
      "Filters": "IsFavorite",
      "userId": "{{user.admin.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "Plain Clip"
      }
     ]
    }
   },
   {
    "name": "unplayed filter leaves it out",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "MusicVideo",
      "SortBy": "SortName",
      "Filters": "IsUnplayed",
      "userId": "{{user.admin.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 12
      }
     ]
    }
   }
  ],
  "cleanup": [
   {
    "name": "unmark played",
    "as": "admin",
    "request": {
     "method": "DELETE",
     "path": "/UserPlayedItems/{{item.mvplain.id}}",
     "query": {
      "userId": "{{user.admin.id}}"
     }
    },
    "expect": {
     "status": [
      200,
      204
     ]
    }
   },
   {
    "name": "unfavorite",
    "as": "admin",
    "request": {
     "method": "DELETE",
     "path": "/UserFavoriteItems/{{item.mvplain.id}}",
     "query": {
      "userId": "{{user.admin.id}}"
     }
    },
    "expect": {
     "status": [
      200,
      204
     ]
    }
   }
  ]
 },
 {
  "id": "musicvideos.scan.incremental",
  "endpoint": "POST /Items/{itemId}/Refresh",
  "spec": "musicvideos.md",
  "scope": "modern",
  "tags": [
   "musicvideos"
  ],
  "covers": [
   "musicvideos.scan.R9"
  ],
  "requires": [
   "library:musicvideos",
   "fs:write"
  ],
  "steps": [
   {
    "name": "a new clip appears",
    "request": {
     "method": "",
     "path": ""
    },
    "expect": {},
    "fs": {
     "copy": "MusicVideos/Plain Clip.mp4",
     "to": "MusicVideos/Added Clip.mp4"
    }
   },
   {
    "name": "a refresh of the library",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{library.musicvideos.id}}/Refresh",
     "query": {
      "Recursive": "true",
      "MetadataRefreshMode": "Default",
      "ImageRefreshMode": "Default"
     }
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "it is cataloged",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "MusicVideo",
      "SortBy": "SortName",
      "SearchTerm": "Added Clip"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "Added Clip"
      }
     ]
    },
    "retryMs": 20000
   },
   {
    "name": "the others stay",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "MusicVideo",
      "SortBy": "SortName"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 14
      }
     ]
    }
   },
   {
    "name": "it goes away again",
    "request": {
     "method": "",
     "path": ""
    },
    "expect": {},
    "fs": {
     "remove": "MusicVideos/Added Clip.mp4"
    }
   },
   {
    "name": "a second refresh forgets it",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{library.musicvideos.id}}/Refresh",
     "query": {
      "Recursive": "true",
      "MetadataRefreshMode": "Default",
      "ImageRefreshMode": "Default"
     }
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "it is gone",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "MusicVideo",
      "SortBy": "SortName"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 13
      }
     ]
    },
    "retryMs": 20000
   }
  ],
  "cleanup": [
   {
    "name": "remove the added clip",
    "request": {
     "method": "",
     "path": ""
    },
    "expect": {},
    "fs": {
     "remove": "MusicVideos/Added Clip.mp4"
    }
   }
  ]
 }
]
