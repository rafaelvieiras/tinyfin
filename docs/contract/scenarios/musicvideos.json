       "op": "absent"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "musicvideos.images.local",
  "endpoint": "GET /Items/{itemId}/Images/{imageType}",
  "spec": "musicvideos.md",
  "scope": "modern",
  "tags": [
   "musicvideos"
  ],
  "covers": [
   "musicvideos.images.R1",
   "musicvideos.images.R2",
   "musicvideos.images.R3"
  ],
  "requires": [
   "library:musicvideos",
   "item:mvnine",
   "item:mvsecond",
   "item:mvartist9",
   "item:mvnestclip"
  ],
  "steps": [
   {
    "name": "\"<name>-thumb.jpg\" is the Thumb",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mvnine.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.ImageTags.Thumb",
       "op": "hex32"
      }
     ]
    }
   },
   {
    "name": "and is served",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mvnine.id}}/Images/Thumb"
    },
    "expect": {
     "status": 200,
     "headers": {
      "Content-Type": "/^image\\/jpeg/"
     }
    }
   },
   {
    "name": "\"<name>.jpg\" is the Primary",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mvsecond.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.ImageTags.Primary",
       "op": "hex32"
      },
      {
       "path": "$.ImageTags.Thumb",
       "op": "absent"
      },
      {
       "path": "$.PrimaryImageAspectRatio",
       "op": "eq",
       "value": 1
      }
     ]
    }
   },
   {
    "name": "and is served",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mvsecond.id}}/Images/Primary"
    },
    "expect": {
     "status": 200,
     "headers": {
      "Content-Type": "/^image\\/jpeg/"
     }
    }
   },
   {
    "name": "folder.jpg of a folder is its Primary",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mvartist9.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.ImageTags.Primary",
       "op": "hex32"
      },
      {
       "path": "$.PrimaryImageAspectRatio",
       "op": "eq",
       "value": 1
      }
     ]
    }
   },
   {
    "name": "folder.jpg of a folder with a single clip is that clip's Primary",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mvnestclip.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
