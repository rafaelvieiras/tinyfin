     "method": "GET",
     "path": "/Artists/Nfo%20Artist"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Type",
       "op": "eq",
       "value": "MusicArtist"
      },
      {
       "path": "$.Name",
       "op": "eq",
       "value": "Nfo Artist"
      },
      {
       "path": "$.MusicVideoCount",
       "op": "eq",
       "value": 1
      }
     ]
    }
   },
   {
    "name": "ArtistIds lists the artist's clips",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "ArtistIds": "{{capture.artist}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "Second Song Nfo"
      },
      {
       "path": "$.Items[0].Type",
       "op": "eq",
       "value": "MusicVideo"
      }
     ]
    }
   },
   {
