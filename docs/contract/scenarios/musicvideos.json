    "name": "every artist the nfo files name",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Artists",
     "query": {
      "ParentId": "{{library.musicvideos.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 3
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "Guest Artist"
      },
      {
       "path": "$.Items[1].Name",
       "op": "eq",
       "value": "Nfo Artist"
      },
      {
       "path": "$.Items[2].Name",
       "op": "eq",
       "value": "Tenth Artist"
      },
      {
       "path": "$.Items[0].Id",
       "op": "hex32"
      }
     ]
    },
    "capture": {
     "artist": "$.Items[1].Id"
    }
   },
   {
    "name": "they are not album artists",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Artists/AlbumArtists",
     "query": {
      "ParentId": "{{library.musicvideos.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 0
      }
     ]
    }
   },
   {
    "name": "an artist counts its music videos",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{capture.artist}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Type",
       "op": "eq",
       "value": "MusicArtist"
      },
      {
       "path": "$.Name",
       "op": "eq",
       "value": "Nfo Artist"
      },
      {
       "path": "$.MusicVideoCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.SongCount",
       "op": "eq",
       "value": 0
      },
      {
       "path": "$.AlbumCount",
       "op": "eq",
       "value": 0
      },
      {
       "path": "$.ChildCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.Genres",
       "op": "len",
       "value": 2
      },
      {
       "path": "$.Genres[0]",
       "op": "eq",
       "value": "Dance"
      },
      {
       "path": "$.Genres[1]",
       "op": "eq",
       "value": "Synthpop"
      }
     ]
    }
   },
   {
    "name": "and is found by name",
    "as": "admin",
