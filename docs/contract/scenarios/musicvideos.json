[
 {
  "id": "musicvideos.scan.list",
  "endpoint": "GET /Items",
  "spec": "musicvideos.md",
  "scope": "modern",
  "tags": [
   "musicvideos"
  ],
  "covers": [
   "musicvideos.scan.R1",
   "musicvideos.scan.R2"
  ],
  "requires": [
   "library:musicvideos",
   "item:mvsecond"
  ],
  "steps": [
   {
    "name": "every video file is a music video, in name order",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "MusicVideo",
      "SortBy": "SortName"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 13
      },
      {
       "path": "$.Items[*].Type",
       "op": "allmatch",
       "value": "^MusicVideo$"
      },
      {
       "path": "$.Items[*].MediaType",
       "op": "allmatch",
       "value": "^Video$"
      },
      {
       "path": "$.Items[0].IsFolder",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "Deep"
      },
      {
       "path": "$.Items[1].Name",
       "op": "eq",
       "value": "Deep Clip"
      },
      {
       "path": "$.Items[2].Name",
       "op": "eq",
       "value": "Dua Lipa - Levitating (2020)"
      },
      {
       "path": "$.Items[6].Name",
       "op": "eq",
       "value": "Plain Clip"
      },
      {
       "path": "$.Items[12].Name",
       "op": "eq",
       "value": "Two"
      }
     ]
    }
   },
   {
    "name": "streams and duration come from the file",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mvsecond.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Container",
       "op": "eq",
       "value": "mkv"
      },
      {
       "path": "$.RunTimeTicks",
       "op": "gte",
       "value": 29000000
      },
      {
       "path": "$.RunTimeTicks",
       "op": "lte",
       "value": 31000000
      },
      {
       "path": "$.MediaSources[0].Container",
       "op": "eq",
       "value": "mkv"
      },
      {
       "path": "$.MediaSources[0].MediaStreams[0].Type",
       "op": "eq",
       "value": "Video"
      },
      {
       "path": "$.MediaSources[0].MediaStreams[0].Codec",
       "op": "eq",
       "value": "h264"
      },
      {
       "path": "$.MediaSources[0].MediaStreams[1].Type",
       "op": "eq",
       "value": "Audio"
      },
      {
       "path": "$.Path",
       "op": "contains",
       "value": "MusicVideos/Artist Nine/Second Song.mkv"
      },
      {
       "path": "$.IsFolder",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.MediaType",
       "op": "eq",
       "value": "Video"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "musicvideos.scan.folders",
  "endpoint": "GET /Items",
  "spec": "musicvideos.md",
  "scope": "modern",
  "tags": [
   "musicvideos"
  ],
  "covers": [
   "musicvideos.scan.R3",
   "musicvideos.scan.R4"
  ],
  "requires": [
   "library:musicvideos",
   "item:mvartist9",
   "item:mvmixed",
   "item:mvdocs",
   "item:mvtenth",
   "item:mvnest"
  ],
  "steps": [
   {
    "name": "folders that hold more than one clip, or a clip and folders, are folder items",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "Folder",
      "SortBy": "SortName",
      "ParentId": "{{library.musicvideos.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 8
      },
      {
       "path": "$.Items[*].Type",
       "op": "allmatch",
       "value": "^Folder$"
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "Artist Nine"
      },
      {
       "path": "$.Items[1].Name",
       "op": "eq",
       "value": "Docs Dir"
      },
      {
       "path": "$.Items[2].Name",
       "op": "eq",
       "value": "Mixed"
      },
      {
       "path": "$.Items[3].Name",
       "op": "eq",
       "value": "MusicVideos"
      },
      {
       "path": "$.Items[4].Name",
       "op": "eq",
       "value": "Nest"
      },
      {
       "path": "$.Items[5].Name",
       "op": "eq",
       "value": "Notes"
      },
      {
       "path": "$.Items[6].Name",
       "op": "eq",
       "value": "Tenth Artist"
      },
      {
       "path": "$.Items[7].Name",
       "op": "eq",
       "value": "Ver Dir"
      }
     ]
    }
   },
   {
    "name": "a folder with a single clip is not an item (Album One, Solo Folder, Inner, Part Dir)",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "Folder",
      "SearchTerm": "Solo"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 0
      }
     ]
    }
   },
   {
    "name": "nor is the folder of a stacked clip",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "Folder",
      "SearchTerm": "Part Dir"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 0
      }
     ]
    }
   },
   {
    "name": "children of a folder with two clips",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{item.mvartist9.id}}",
      "SortBy": "SortName"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "Nine Song"
      },
      {
       "path": "$.Items[1].Name",
       "op": "eq",
       "value": "Second Song Nfo"
      }
     ]
    }
   },
   {
    "name": "the clip of a single-clip sub folder belongs to the folder above it",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{item.mvmixed.id}}",
      "SortBy": "SortName"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "One"
      },
      {
       "path": "$.Items[1].Name",
       "op": "eq",
       "value": "Two"
      }
     ]
    }
   },
   {
    "name": "a clip beside a non-clip folder keeps its folder",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{item.mvdocs.id}}",
      "SortBy": "SortName"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "Main"
      },
      {
       "path": "$.Items[0].Type",
       "op": "eq",
       "value": "MusicVideo"
      },
      {
       "path": "$.Items[1].Name",
       "op": "eq",
       "value": "Notes"
      },
      {
       "path": "$.Items[1].Type",
       "op": "eq",
       "value": "Folder"
      }
     ]
    }
   },
   {
    "name": "Album One collapses: the clip hangs off Tenth Artist",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{item.mvtenth.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "Deep Clip"
      }
     ]
    }
   },
   {
    "name": "nested single-clip folders collapse one by one",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{item.mvnest.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "Deep"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "musicvideos.scan.names",
  "endpoint": "GET /Items/{itemId}",
  "spec": "musicvideos.md",
  "scope": "modern",
  "tags": [
   "musicvideos"
  ],
  "covers": [
   "musicvideos.scan.R5",
   "musicvideos.scan.R6"
  ],
  "requires": [
   "library:musicvideos",
   "item:mvdua",
   "item:mvsolo",
   "item:mvplain"
  ],
  "steps": [
   {
    "name": "named after the file, year read from it and kept in the name",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mvdua.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Name",
       "op": "eq",
       "value": "Dua Lipa - Levitating (2020)"
      },
      {
       "path": "$.ProductionYear",
       "op": "eq",
       "value": 2020
      },
      {
       "path": "$.Artists",
       "op": "len",
       "value": 0
      },
      {
       "path": "$.ArtistItems",
       "op": "len",
       "value": 0
      },
      {
       "path": "$.Album",
       "op": "absent"
      }
     ]
    }
   },
   {
    "name": "a clip alone in its folder is named after its file, not the folder",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mvsolo.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Name",
       "op": "eq",
       "value": "Solo Clip (2010)"
      },
      {
       "path": "$.ProductionYear",
       "op": "eq",
       "value": 2010
      }
     ]
    }
   },
   {
    "name": "a loose file has no year",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mvplain.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Name",
       "op": "eq",
       "value": "Plain Clip"
      },
      {
       "path": "$.ProductionYear",
       "op": "absent"
      }
     ]
    }
   },
   {
    "name": "year from a files name is in the year filter",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "MusicVideo",
      "SortBy": "SortName",
      "Years": "2010"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "Solo Clip (2010)"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "musicvideos.scan.stack",
  "endpoint": "GET /Items/{itemId}",
  "spec": "musicvideos.md",
  "scope": "modern",
  "tags": [
   "musicvideos"
  ],
  "covers": [
   "musicvideos.scan.R7",
   "musicvideos.scan.R8"
  ],
  "requires": [
   "library:musicvideos",
   "item:mvpart",
   "item:mvverdir",
   "item:mvver1"
  ],
  "steps": [
   {
    "name": "the parts of a stacked clip are one clip, the first part",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mvpart.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Name",
       "op": "eq",
       "value": "Song - part1"
      },
      {
       "path": "$.PartCount",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.Type",
       "op": "eq",
       "value": "MusicVideo"
      }
     ]
    }
   },
   {
    "name": "the second part is not cataloged",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "SearchTerm": "part2"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 0
      }
     ]
    }
   },
   {
    "name": "files that merely share a name stay separate clips",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{item.mvverdir.id}}",
      "SortBy": "SortName"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "Song"
      },
      {
       "path": "$.Items[1].Name",
       "op": "eq",
       "value": "Song - 4K"
      },
      {
       "path": "$.Items[0].PartCount",
       "op": "absent"
      }
     ]
    }
   },
   {
    "name": "and have no extra media sources",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mvver1.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources",
       "op": "len",
       "value": 1
      },
      {
       "path": "$.PartCount",
       "op": "absent"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "musicvideos.nfo.fields",
  "endpoint": "GET /Items/{itemId}",
  "spec": "musicvideos.md",
  "scope": "modern",
  "tags": [
   "musicvideos"
  ],
  "covers": [
   "musicvideos.nfo.R1"
  ],
  "requires": [
   "library:musicvideos",
   "item:mvsecond",
   "item:mvdeep"
  ],
  "steps": [
   {
    "name": "the nfo gives title, artists, album, year, genres and plot",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mvsecond.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Name",
       "op": "eq",
       "value": "Second Song Nfo"
      },
      {
       "path": "$.Artists",
       "op": "len",
       "value": 2
      },
      {
       "path": "$.Artists[0]",
       "op": "eq",
       "value": "Nfo Artist"
      },
      {
       "path": "$.Artists[1]",
       "op": "eq",
       "value": "Guest Artist"
      },
      {
       "path": "$.ArtistItems",
       "op": "len",
       "value": 2
      },
      {
       "path": "$.ArtistItems[0].Name",
       "op": "eq",
       "value": "Nfo Artist"
      },
      {
       "path": "$.ArtistItems[0].Id",
       "op": "hex32"
      },
      {
       "path": "$.ArtistItems[1].Name",
       "op": "eq",
       "value": "Guest Artist"
      },
      {
       "path": "$.Album",
       "op": "eq",
       "value": "Nfo Album"
      },
      {
       "path": "$.ProductionYear",
       "op": "eq",
       "value": 1999
      },
      {
       "path": "$.Genres",
       "op": "len",
       "value": 2
      },
      {
       "path": "$.Genres[0]",
       "op": "eq",
       "value": "Synthpop"
      },
      {
       "path": "$.Genres[1]",
       "op": "eq",
       "value": "Dance"
      },
      {
       "path": "$.GenreItems[0].Name",
       "op": "eq",
       "value": "Synthpop"
      },
      {
       "path": "$.Overview",
       "op": "eq",
       "value": "Described by its nfo."
      }
     ]
    }
   },
   {
    "name": "an nfo beside a clip of a collapsed folder applies as well",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mvdeep.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Name",
       "op": "eq",
       "value": "Deep Clip"
      },
      {
       "path": "$.ProductionYear",
       "op": "eq",
       "value": 2004
      },
      {
       "path": "$.Artists",
       "op": "len",
       "value": 1
      },
      {
       "path": "$.Artists[0]",
       "op": "eq",
       "value": "Tenth Artist"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
