 {
  "id": "musicvideos.playback.direct",
  "endpoint": "POST /Items/{itemId}/PlaybackInfo",
  "spec": "musicvideos.md",
  "scope": "modern",
  "tags": [
   "musicvideos"
  ],
  "covers": [
   "musicvideos.playback.R1",
   "musicvideos.playback.R2"
  ],
  "requires": [
   "library:musicvideos",
   "item:mvsecond",
   "item:mvplain"
  ],
  "steps": [
   {
    "name": "a mkv clip plays directly",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.mvsecond.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.mvsecond.id}}"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mp4,mkv",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources",
       "op": "len",
       "value": 1
      },
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].Container",
       "op": "eq",
       "value": "mkv"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "absent"
      }
     ]
    }
   },
   {
    "name": "and is streamed as the file",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Videos/{{item.mvsecond.id}}/stream",
     "query": {
      "static": "true",
      "mediaSourceId": "{{item.mvsecond.id}}"
     }
    },
    "expect": {
     "status": 200,
     "headers": {
      "Content-Type": "/matroska/"
     }
    }
   },
   {
    "name": "an mp4 clip too",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Videos/{{item.mvplain.id}}/stream",
     "query": {
      "static": "true",
      "mediaSourceId": "{{item.mvplain.id}}"
     }
    },
    "expect": {
     "status": 200,
     "headers": {
      "Content-Type": "/^video\\/mp4/"
     }
    }
   },
   {
    "name": "the file downloads",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mvsecond.id}}/Download"
    },
    "expect": {
     "status": 200,
     "headers": {
      "Content-Type": "/matroska/"
     }
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "musicvideos.playback.transcode",
