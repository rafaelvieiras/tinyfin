     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "Guest Artist"
      },
      {
       "path": "$.Items[1].Name",
       "op": "eq",
       "value": "Nfo Artist"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
