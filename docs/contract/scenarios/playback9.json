  {
    "id": "playback.offer.item-container",
    "endpoint": "POST /Items/{itemId}/PlaybackInfo",
    "spec": "playback.md#offer",
    "scope": "modern",
    "tags": [
      "playback",
      "items"
    ],
    "covers": [
      "playback.offer.R19"
    ],
    "requires": [
      "library:probe3",
      "item:p3-ts-aac",
      "item:p3-m2ts",
      "item:p3-mts",
      "item:p3-webm-streams",
      "item:p3-vp9-aac",
      "item:p3-vp9-sub",
      "item:p3-mp4",
      "item:p3-mp4-as-mkv",
      "item:p3-mp4-as-m4v",
      "item:p3-avi-as-mp4",
      "item:p3-mpg"
    ],
    "steps": [
      {
        "name": "p3-ts-aac: item ts, source ts",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Items",
          "query": {
            "Ids": "{{item.p3-ts-aac.id}}",
            "Fields": "MediaSources"
          }
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$.Items[0].Container",
              "op": "eq",
              "value": "ts"
            },
            {
              "path": "$.Items[0].MediaSources[0].Container",
              "op": "eq",
              "value": "ts"
            }
          ]
        }
      },
      {
        "name": "p3-m2ts: item ts, source ts",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Items",
          "query": {
