          ]
        }
      },
      {
        "name": "a profile listing webm gets that name",
        "as": "admin",
        "request": {
          "method": "POST",
          "path": "/Items/{{item.p3-webm-streams.id}}/PlaybackInfo",
          "query": {
            "MediaSourceId": "{{item.p3-webm-streams.id}}"
          },
          "body": {
            "DeviceProfile": {
              "DirectPlayProfiles": [
                {
                  "Container": "webm",
                  "Type": "Video",
                  "VideoCodec": "vp9",
                  "AudioCodec": "opus"
                }
              ],
              "TranscodingProfiles": [
                {
                  "Container": "ts",
                  "Type": "Video",
                  "Protocol": "hls",
                  "VideoCodec": "h264",
                  "AudioCodec": "aac",
                  "Context": "Streaming"
                }
              ]
            }
          }
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$.MediaSources[0].Container",
              "op": "eq",
              "value": "webm"
            },
            {
              "path": "$.MediaSources[0].SupportsDirectPlay",
              "op": "eq",
              "value": true
            }
          ]
        }
      }
    ]
  },
