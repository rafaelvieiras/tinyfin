  {
    "id": "playback.offer.transcode-codec-reasons",
    "endpoint": "POST /Items/{itemId}/PlaybackInfo",
    "spec": "playback.md#offer",
    "scope": "modern",
    "tags": [
      "playback"
    ],
    "covers": [
      "playback.offer.R24"
    ],
    "requires": [
      "library:probe3",
      "item:p3-hevc-mp4",
      "item:p3-h264-mp4"
    ],
    "steps": [
      {
        "name": "HEVC, condition fails, the profile transcodes to h264: the picture is named first",
        "as": "admin",
        "request": {
          "method": "POST",
          "path": "/Items/{{item.p3-hevc-mp4.id}}/PlaybackInfo",
          "query": {
            "MediaSourceId": "{{item.p3-hevc-mp4.id}}"
          },
          "body": {
            "DeviceProfile": {
              "DirectPlayProfiles": [
                {
                  "Container": "mp4",
                  "Type": "Video",
                  "VideoCodec": "h264,hevc",
                  "AudioCodec": "aac"
                }
              ],
              "TranscodingProfiles": [
                {
                  "Container": "ts",
                  "Type": "Video",
                  "Protocol": "hls",
                  "VideoCodec": "h264",
                  "AudioCodec": "aac",
                  "Context": "Streaming"
                }
              ],
              "CodecProfiles": [
                {
                  "Type": "Video",
                  "Conditions": [
                    {
                      "Condition": "LessThanEqual",
                      "Property": "Width",
                      "Value": "100",
                      "IsRequired": true
                    }
                  ]
                }
              ]
            }
          }
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$.MediaSources[0].TranscodingUrl",
              "op": "contains",
              "value": "TranscodeReasons=VideoCodecNotSupported,VideoResolutionNotSupported"
            }
          ]
        }
      },
      {
        "name": "H.264 is produced: the condition only",
        "as": "admin",
        "request": {
          "method": "POST",
          "path": "/Items/{{item.p3-h264-mp4.id}}/PlaybackInfo",
          "query": {
            "MediaSourceId": "{{item.p3-h264-mp4.id}}"
          },
          "body": {
            "DeviceProfile": {
              "DirectPlayProfiles": [
                {
                  "Container": "mp4",
                  "Type": "Video",
                  "VideoCodec": "h264,hevc",
                  "AudioCodec": "aac"
                }
              ],
              "TranscodingProfiles": [
                {
                  "Container": "ts",
                  "Type": "Video",
                  "Protocol": "hls",
                  "VideoCodec": "h264",
                  "AudioCodec": "aac",
                  "Context": "Streaming"
                }
              ],
              "CodecProfiles": [
                {
                  "Type": "Video",
                  "Conditions": [
                    {
                      "Condition": "LessThanEqual",
                      "Property": "Width",
                      "Value": "100",
                      "IsRequired": true
                    }
                  ]
                }
              ]
            }
          }
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$.MediaSources[0].TranscodingUrl",
              "op": "contains",
              "value": "TranscodeReasons=VideoResolutionNotSupported"
            },
            {
              "path": "$.MediaSources[0].TranscodingUrl",
              "op": "notcontains",
              "value": "VideoCodecNotSupported"
            }
          ]
        }
      },
      {
        "name": "HEVC is produced too: the condition only",
        "as": "admin",
        "request": {
          "method": "POST",
          "path": "/Items/{{item.p3-hevc-mp4.id}}/PlaybackInfo",
          "query": {
            "MediaSourceId": "{{item.p3-hevc-mp4.id}}"
          },
          "body": {
            "DeviceProfile": {
              "DirectPlayProfiles": [
                {
                  "Container": "mp4",
                  "Type": "Video",
                  "VideoCodec": "h264,hevc",
                  "AudioCodec": "aac"
                }
              ],
              "TranscodingProfiles": [
                {
                  "Container": "ts",
                  "Type": "Video",
                  "Protocol": "hls",
                  "VideoCodec": "h264,hevc",
                  "AudioCodec": "aac",
                  "Context": "Streaming"
                }
              ],
              "CodecProfiles": [
                {
                  "Type": "Video",
                  "Conditions": [
                    {
                      "Condition": "LessThanEqual",
                      "Property": "Width",
                      "Value": "100",
                      "IsRequired": true
                    }
                  ]
                }
              ]
            }
          }
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$.MediaSources[0].TranscodingUrl",
              "op": "contains",
              "value": "TranscodeReasons=VideoResolutionNotSupported"
            },
            {
              "path": "$.MediaSources[0].TranscodingUrl",
              "op": "notcontains",
              "value": "VideoCodecNotSupported"
            }
          ]
        }
      },
      {
