      {
        "name": "p3-mpg offered as mpeg",
        "as": "admin",
        "request": {
          "method": "POST",
          "path": "/Items/{{item.p3-mpg.id}}/PlaybackInfo",
          "query": {
            "MediaSourceId": "{{item.p3-mpg.id}}"
