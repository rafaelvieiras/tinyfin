  {
    "id": "playback.offer.ts-bitrate",
    "endpoint": "POST /Items/{itemId}/PlaybackInfo",
    "spec": "playback.md#offer",
    "scope": "modern",
    "tags": [
      "playback"
    ],
    "covers": [
      "playback.offer.R21"
    ],
    "requires": [
      "library:probe3",
      "item:p3-ts-aac",
      "item:p3-m2ts",
      "item:p3-mts"
    ],
    "steps": [
      {
        "name": "ts: the sound as ffprobe measures it, the rest to the picture",
        "as": "admin",
        "request": {
          "method": "POST",
          "path": "/Items/{{item.p3-ts-aac.id}}/PlaybackInfo",
          "query": {
            "MediaSourceId": "{{item.p3-ts-aac.id}}"
          },
          "body": {}
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$.MediaSources[0].MediaStreams[0].BitRate",
              "op": "eq",
              "value": 118604
            },
            {
              "path": "$.MediaSources[0].MediaStreams[1].BitRate",
              "op": "eq",
              "value": 130790
            }
          ]
        }
      },
      {
        "name": "m2ts: likewise",
        "as": "admin",
        "request": {
          "method": "POST",
          "path": "/Items/{{item.p3-m2ts.id}}/PlaybackInfo",
          "query": {
            "MediaSourceId": "{{item.p3-m2ts.id}}"
          },
          "body": {}
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$.MediaSources[0].MediaStreams[0].BitRate",
              "op": "eq",
              "value": 129503
            },
            {
              "path": "$.MediaSources[0].MediaStreams[1].BitRate",
              "op": "eq",
              "value": 130790
            }
          ]
        }
      },
      {
        "name": "mts with ac3 states the rate",
        "as": "admin",
        "request": {
