     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items",
       "op": "len",
       "value": 6
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Loose Five"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Loose In Eleven"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Mu One"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "People One"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "People Two"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Guest Turn"
      }
     ]
    }
   },
   {
    "name": "capture Carl Composer",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Persons/Carl%20Composer"
    },
    "expect": {
     "status": 200
    },
    "capture": {
     "p_comp": "$.Id"
    }
   },
   {
    "name": "capture Guest Five",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Persons/Guest%20Five"
    },
    "expect": {
     "status": 200
    },
    "capture": {
     "p_guest": "$.Id"
    }
   },
   {
    "name": "capture Artist Twelve",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Persons/Artist%20Twelve"
    },
    "expect": {
     "status": 200
    },
    "capture": {
     "p_art12": "$.Id"
    }
   },
   {
    "name": "PersonIds",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{library.music5.id}}",
      "Recursive": "true",
      "PersonIds": "{{capture.p_comp}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items",
       "op": "len",
       "value": 2
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "People One"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "People Two"
      }
     ]
    }
   },
   {
    "name": "PersonIds lists are a union",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{library.music5.id}}",
      "Recursive": "true",
      "PersonIds": "{{capture.p_guest}},{{capture.p_comp}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items",
       "op": "len",
       "value": 4
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Guest Turn"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Album Xi"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "People One"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "People Two"
      }
     ]
    }
   },
   {
