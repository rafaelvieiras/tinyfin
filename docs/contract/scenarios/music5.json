    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items",
       "op": "len",
       "value": 0
      }
     ]
    }
   },
   {
    "name": "a composer value is not split",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
