     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items",
       "op": "len",
       "value": 2
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "People One"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "People Two"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Album Nu"
      }
     ]
    }
   },
   {
    "name": "composer under another credit type: nothing",
