      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Duo One;Duo Two"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Artist Twelve"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Guest Five"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Various Five"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Root Five"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Artist Eleven"
      },
      {
       "path": "$.Items[*].Type",
       "op": "notcontains",
       "value": "MusicArtist"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Connie Conductor"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Percy Performer"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Lyle Lyricist"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Album Nu"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "People One"
      }
     ]
    }
   },
   {
    "name": "Composer credits only",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Persons",
     "query": {
      "PersonTypes": "Composer"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Carl Composer"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Duo One;Duo Two"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Artist Twelve"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Guest Five"
      }
     ]
    }
   },
   {
    "name": "Artist credits only",
