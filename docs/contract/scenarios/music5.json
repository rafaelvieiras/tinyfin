    "request": {
     "method": "GET",
     "path": "/Persons",
     "query": {
      "PersonTypes": "Artist"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Guest Five"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Artist Twelve"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Various Five"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Carl Composer"
      }
     ]
    }
   },
   {
    "name": "AlbumArtist credits only",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Persons",
     "query": {
      "PersonTypes": "AlbumArtist"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Various Five"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Artist Twelve"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Guest Five"
      }
     ]
    }
   },
   {
    "name": "no conductor credits exist",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Persons",
     "query": {
      "PersonTypes": "Conductor,Lyricist,Performer"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Connie Conductor"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Percy Performer"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Carl Composer"
      }
     ]
    }
   },
   {
    "name": "ExcludePersonTypes drops names only credited with those types",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Persons",
     "query": {
      "ExcludePersonTypes": "Artist,AlbumArtist",
      "ParentId": "{{library.music5.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Carl Composer"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Guest Five"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Various Five"
      }
     ]
    }
   },
   {
    "name": "IncludeItemTypes does not narrow the list",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Persons",
     "query": {
      "IncludeItemTypes": "MusicAlbum"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Carl Composer"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Guest Five"
      }
     ]
    }
   },
   {
    "name": "IncludeItemTypes=Movie does not narrow it either",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Persons",
     "query": {
      "IncludeItemTypes": "Movie"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Carl Composer"
      }
     ]
    }
   },
   {
    "name": "SearchTerm",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Persons",
     "query": {
      "SearchTerm": "Duo One"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Duo One;Duo Two"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Carl Composer"
      }
     ]
    }
   },
   {
    "name": "NameStartsWith",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Persons",
     "query": {
      "NameStartsWith": "Carl"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Carl Composer"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Guest Five"
      }
     ]
    }
   },
   {
    "name": "Limit and StartIndex",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Persons",
     "query": {
      "Limit": "2",
      "StartIndex": "1",
      "ParentId": "{{library.music5.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items",
       "op": "len",
       "value": 2
      },
      {
       "path": "$.StartIndex",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "Artist Twelve"
      }
     ]
    }
   },
   {
    "name": "a person has its own id, not the artist item's",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Persons/Artist%20Twelve"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Type",
       "op": "eq",
       "value": "Person"
      },
      {
       "path": "$.Name",
       "op": "eq",
       "value": "Artist Twelve"
      },
      {
       "path": "$.Id",
       "op": "ne",
       "value": "{{item.m5artist12.id}}"
      },
      {
       "path": "$.Id",
       "op": "hex32"
      }
     ]
    },
    "capture": {
     "pid": "$.Id"
    }
   },
   {
    "name": "a name nobody credits is 404",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Persons/Nobody%20Credited"
    },
    "expect": {
     "status": 404
    }
   }
  ]
 },
 {
  "id": "music.people.filter",
  "endpoint": "GET /Items",
  "spec": "music.md",
  "scope": "modern",
  "tags": [
   "music"
  ],
  "covers": [
   "music.people.R5"
  ],
  "requires": [
   "library:music5"
  ],
  "steps": [
   {
    "name": "Person + Artist: tracks and albums by the track artist",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{library.music5.id}}",
      "Recursive": "true",
      "Person": "Guest Five",
      "PersonTypes": "Artist"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items",
       "op": "len",
       "value": 2
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Guest Turn"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Album Xi"
      }
     ]
    }
   },
   {
    "name": "Person + AlbumArtist: not a credit of the track artist",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{library.music5.id}}",
      "Recursive": "true",
      "Person": "Guest Five",
      "PersonTypes": "AlbumArtist"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items",
       "op": "len",
       "value": 0
      }
     ]
    }
   },
   {
    "name": "album artist credits the track and the album",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{library.music5.id}}",
      "Recursive": "true",
      "Person": "Various Five",
      "PersonTypes": "AlbumArtist"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items",
       "op": "len",
       "value": 2
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Guest Turn"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Album Xi"
      }
     ]
    }
   },
   {
    "name": "album artist is not an Artist credit",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{library.music5.id}}",
      "Recursive": "true",
      "Person": "Various Five",
      "PersonTypes": "Artist"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items",
       "op": "len",
       "value": 0
      }
     ]
    }
   },
   {
    "name": "Person alone, any credit type",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{library.music5.id}}",
      "Recursive": "true",
      "Person": "Various Five"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items",
       "op": "len",
       "value": 2
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Guest Turn"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Album Xi"
      }
     ]
    }
   },
   {
    "name": "composer",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{library.music5.id}}",
      "Recursive": "true",
