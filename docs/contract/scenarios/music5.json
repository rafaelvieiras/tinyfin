       "op": "contains",
       "value": "People One"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "People Two"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Album Nu"
      }
     ]
    }
