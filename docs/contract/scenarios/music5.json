[
 {
  "id": "music.latest.loose",
  "endpoint": "GET /Items/Latest",
  "spec": "music.md",
  "scope": "modern",
  "tags": [
   "music"
  ],
  "covers": [
   "music.latest.R4",
   "music.latest.R5",
   "music.latest.R6"
  ],
  "requires": [
   "library:music5"
  ],
  "steps": [
   {
    "name": "library, grouped: albums only, loose tracks left out",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/Latest",
     "query": {
      "ParentId": "{{library.music5.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$",
       "op": "len",
       "value": 3
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Album Mu"
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Album Nu"
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Album Xi"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Loose Five"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Loose In Eleven"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Mu One"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "People One"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "People Two"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Guest Turn"
      }
     ]
    }
   },
   {
    "name": "library, grouped, Audio asked for: still albums only",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/Latest",
     "query": {
      "ParentId": "{{library.music5.id}}",
      "IncludeItemTypes": "Audio"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$",
       "op": "len",
       "value": 3
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Album Mu"
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Album Nu"
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Album Xi"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Loose Five"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Loose In Eleven"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Mu One"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "People One"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "People Two"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Guest Turn"
      }
     ]
    }
   },
   {
    "name": "no parent, grouped, with other kinds of library around: albums and the loose tracks",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/Latest",
     "query": {
      "IncludeItemTypes": "Audio",
      "Limit": "20"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Album Mu"
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Loose Five"
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Loose In Eleven"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Mu One"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "People One"
      },
      {
       "path": "$[?Name=Loose Five].Type",
       "op": "eq",
       "value": "Audio"
      }
     ]
    }
   },
   {
    "name": "no parent, no types: the same",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/Latest",
     "query": {
      "Limit": "20"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Album Nu"
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Loose Five"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Mu One"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Artist Eleven"
      }
     ]
    }
   },
   {
    "name": "no parent, MusicAlbum asked for: albums only",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/Latest",
     "query": {
      "IncludeItemTypes": "MusicAlbum",
      "Limit": "20"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Album Nu"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Loose Five"
      }
     ]
    }
   },
   {
    "name": "library, ungrouped: every track",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/Latest",
     "query": {
      "ParentId": "{{library.music5.id}}",
      "GroupItems": "false"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$",
       "op": "len",
       "value": 6
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Loose Five"
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Loose In Eleven"
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Mu One"
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "People One"
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "People Two"
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Guest Turn"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Album Mu"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Album Nu"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Album Xi"
      }
     ]
    }
   },
   {
    "name": "artist folder, grouped: its loose track as itself, its album grouped",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/Latest",
     "query": {
      "ParentId": "{{item.m5artist11.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$",
       "op": "len",
       "value": 2
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Loose In Eleven"
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Album Mu"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Mu One"
      },
      {
       "path": "$[?Name=Loose In Eleven].Type",
       "op": "eq",
       "value": "Audio"
      },
      {
       "path": "$[?Name=Album Mu].Type",
       "op": "eq",
       "value": "MusicAlbum"
      }
     ]
    }
   },
   {
    "name": "artist folder, grouped, Audio asked for: the same",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/Latest",
     "query": {
      "ParentId": "{{item.m5artist11.id}}",
      "IncludeItemTypes": "Audio"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$",
       "op": "len",
       "value": 2
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Loose In Eleven"
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Album Mu"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Mu One"
      }
     ]
    }
   },
   {
    "name": "artist folder, grouped, MusicAlbum asked for: the album only",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/Latest",
     "query": {
      "ParentId": "{{item.m5artist11.id}}",
      "IncludeItemTypes": "MusicAlbum"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$",
       "op": "len",
       "value": 1
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Album Mu"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Loose In Eleven"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Mu One"
      }
     ]
    }
   },
   {
    "name": "artist folder, ungrouped: the tracks",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/Latest",
     "query": {
      "ParentId": "{{item.m5artist11.id}}",
      "GroupItems": "false"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$",
       "op": "len",
       "value": 2
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Loose In Eleven"
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Mu One"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Album Mu"
      }
     ]
    }
   },
   {
    "name": "artist folder without a loose track: its albums",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/Latest",
     "query": {
      "ParentId": "{{item.m5artist12.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$",
       "op": "len",
       "value": 1
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Album Nu"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "People One"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "People Two"
      }
     ]
    }
   },
   {
    "name": "album folder, grouped: the album itself",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/Latest",
     "query": {
      "ParentId": "{{item.m5mu.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$",
       "op": "len",
       "value": 1
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Album Mu"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Mu One"
      }
     ]
    }
   },
   {
    "name": "album folder, ungrouped: its tracks",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/Latest",
     "query": {
      "ParentId": "{{item.m5mu.id}}",
      "GroupItems": "false"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$",
       "op": "len",
       "value": 1
      },
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Mu One"
      },
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Album Mu"
      }
     ]
    }
   }
  ]
 },
 {
  "id": "music.people.track",
  "endpoint": "GET /Items/{itemId}",
  "spec": "music.md",
  "scope": "modern",
  "tags": [
   "music"
  ],
  "covers": [
   "music.people.R1",
   "music.people.R2"
  ],
  "requires": [
   "library:music5"
  ],
  "steps": [
   {
    "name": "FLAC track: composer, album artist, artist; conductor, lyricist and performer tags make none",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.m5people1.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.People",
       "op": "len",
       "value": 3
      },
      {
       "path": "$.People[0].Name",
       "op": "eq",
       "value": "Carl Composer"
      },
      {
       "path": "$.People[0].Type",
       "op": "eq",
       "value": "Composer"
      },
      {
       "path": "$.People[0].Role",
       "op": "eq",
       "value": ""
      },
      {
       "path": "$.People[0].Id",
       "op": "hex32"
      },
      {
       "path": "$.People[1].Name",
       "op": "eq",
       "value": "Artist Twelve"
      },
      {
       "path": "$.People[1].Type",
       "op": "eq",
       "value": "AlbumArtist"
      },
      {
       "path": "$.People[1].Role",
       "op": "eq",
       "value": ""
      },
      {
       "path": "$.People[2].Name",
       "op": "eq",
       "value": "Artist Twelve"
      },
      {
       "path": "$.People[2].Type",
       "op": "eq",
       "value": "Artist"
      },
      {
       "path": "$.People[2].Role",
       "op": "eq",
       "value": ""
      },
      {
       "path": "$.People[*].Name",
       "op": "notcontains",
       "value": "Connie Conductor"
      },
      {
       "path": "$.People[*].Name",
       "op": "notcontains",
       "value": "Lyle Lyricist"
      },
      {
       "path": "$.People[*].Name",
       "op": "notcontains",
       "value": "Percy Performer"
      }
     ]
    }
   },
   {
    "name": "MP3 track: the performer tag makes none",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.m5people2.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.People",
       "op": "len",
       "value": 3
      },
      {
       "path": "$.People[0].Type",
       "op": "eq",
       "value": "Composer"
      },
      {
       "path": "$.People[*].Name",
       "op": "notcontains",
       "value": "Percy Performer"
      }
     ]
    }
   },
   {
    "name": "a composer tag is one name (not split on ';'), album artist and artist apart",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.m5guest.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.People",
       "op": "len",
       "value": 3
      },
      {
       "path": "$.People[0].Name",
       "op": "eq",
       "value": "Duo One;Duo Two"
      },
      {
       "path": "$.People[0].Type",
       "op": "eq",
       "value": "Composer"
      },
      {
       "path": "$.People[1].Name",
       "op": "eq",
       "value": "Various Five"
      },
      {
       "path": "$.People[1].Type",
       "op": "eq",
       "value": "AlbumArtist"
      },
      {
       "path": "$.People[2].Name",
       "op": "eq",
       "value": "Guest Five"
      },
      {
       "path": "$.People[2].Type",
       "op": "eq",
       "value": "Artist"
      }
     ]
    }
   },
   {
    "name": "a loose track: no composer, album artist then artist",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.m5loose.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.People",
       "op": "len",
       "value": 2
      },
      {
       "path": "$.People[0].Type",
       "op": "eq",
       "value": "AlbumArtist"
      },
      {
       "path": "$.People[1].Type",
       "op": "eq",
       "value": "Artist"
      },
      {
       "path": "$.People[0].Name",
       "op": "eq",
       "value": "Root Five"
      }
     ]
    }
   },
   {
    "name": "People in a listing only with Fields=People",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{library.music5.id}}",
      "Recursive": "true",
      "IncludeItemTypes": "Audio",
      "Fields": "People",
      "Limit": "50"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[?Name=People One].People",
       "op": "len",
       "value": 3
      }
     ]
    }
   },
   {
    "name": "a listing without Fields has no People",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{item.m5nu.id}}",
      "IncludeItemTypes": "Audio",
      "Fields": "Genres"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[0].People",
       "op": "absent"
      }
     ]
    }
   }
  ]
 },
