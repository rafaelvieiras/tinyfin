[
 {
  "id": "trickplay.item.short",
  "endpoint": "GET /Items/{itemId}",
  "spec": "trickplay.md",
  "scope": "modern",
  "tags": [
   "trickplay"
  ],
  "covers": [
   "trickplay.generate.R2",
   "trickplay.generate.R3",
   "trickplay.item.R1",
   "trickplay.item.R2"
  ],
  "requires": [
   "library:trickplay",
   "item:tpshort"
  ],
  "steps": [
   {
    "name": "sheets listed on the item",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.tpshort.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Trickplay.{{item.tpshort.id}}.320.Width",
       "op": "eq",
       "value": 320
      },
      {
       "path": "$.Trickplay.{{item.tpshort.id}}.320.Height",
       "op": "eq",
       "value": 240
      },
      {
       "path": "$.Trickplay.{{item.tpshort.id}}.320.TileWidth",
       "op": "eq",
       "value": 10
      },
      {
       "path": "$.Trickplay.{{item.tpshort.id}}.320.TileHeight",
       "op": "eq",
       "value": 10
      },
      {
       "path": "$.Trickplay.{{item.tpshort.id}}.320.ThumbnailCount",
       "op": "eq",
       "value": 3
      },
      {
       "path": "$.Trickplay.{{item.tpshort.id}}.320.Interval",
       "op": "eq",
       "value": 10000
      },
      {
       "path": "$.Trickplay.{{item.tpshort.id}}.320.Bandwidth",
       "op": "type",
       "value": "number"
      },
      {
       "path": "$.Trickplay.{{item.tpshort.id}}.320.Bandwidth",
       "op": "gte",
       "value": 1
      }
     ]
    },
    "retryMs": 30000
   }
  ],
  "cleanup": []
 },
