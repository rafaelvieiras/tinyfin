 {
  "id": "playback.offer.codec-conditions",
  "endpoint": "POST /Items/{itemId}/PlaybackInfo",
  "spec": "playback.md#offer",
  "scope": "modern",
  "tags": [
   "playback"
  ],
  "covers": [
   "playback.offer.R15",
   "playback.offer.R16"
  ],
  "requires": [
   "library:matrix2",
   "item:mx2-dv81",
   "item:mx2-hdr10"
  ],
  "steps": [
   {
    "name": "Dolby Vision 8.1 with a profile without DOVIWithHDR10",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.mx2-dv81.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.mx2-dv81.id}}"
     },
     "body": {
      "DeviceProfile": {
       "DirectPlayProfiles": [
        {
         "Container": "mkv",
         "Type": "Video",
         "VideoCodec": "hevc",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "Protocol": "hls",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Context": "Streaming"
        }
       ],
       "CodecProfiles": [
        {
         "Type": "Video",
         "Conditions": [
          {
           "Condition": "EqualsAny",
           "Property": "VideoRangeType",
           "Value": "SDR|HDR10|HLG",
           "IsRequired": true
          }
         ]
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.MediaSources[0].SupportsTranscoding",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "VideoRangeTypeNotSupported"
      }
     ]
    }
   },
   {
    "name": "the same with it listed",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.mx2-dv81.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.mx2-dv81.id}}"
     },
     "body": {
      "DeviceProfile": {
       "DirectPlayProfiles": [
        {
         "Container": "mkv",
         "Type": "Video",
         "VideoCodec": "hevc",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "Protocol": "hls",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Context": "Streaming"
        }
       ],
       "CodecProfiles": [
        {
         "Type": "Video",
         "Conditions": [
          {
           "Condition": "EqualsAny",
           "Property": "VideoRangeType",
           "Value": "SDR|HDR10|HLG|DOVIWithHDR10",
           "IsRequired": true
          }
         ]
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].SupportsTranscoding",
       "op": "eq",
       "value": true
      }
     ]
    }
   },
   {
    "name": "HDR10 with SDR only",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.mx2-hdr10.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.mx2-hdr10.id}}"
     },
     "body": {
      "DeviceProfile": {
       "DirectPlayProfiles": [
        {
         "Container": "mkv",
         "Type": "Video",
         "VideoCodec": "hevc",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "Protocol": "hls",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Context": "Streaming"
        }
       ],
       "CodecProfiles": [
        {
         "Type": "Video",
         "Conditions": [
          {
           "Condition": "EqualsAny",
           "Property": "VideoRangeType",
           "Value": "SDR",
           "IsRequired": true
          }
         ]
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.MediaSources[0].SupportsTranscoding",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "VideoRangeTypeNotSupported"
      }
     ]
    }
   },
   {
    "name": "a width limit",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.mx2-hdr10.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.mx2-hdr10.id}}"
     },
     "body": {
      "DeviceProfile": {
       "DirectPlayProfiles": [
        {
         "Container": "mkv",
         "Type": "Video",
         "VideoCodec": "hevc",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "Protocol": "hls",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Context": "Streaming"
        }
       ],
       "CodecProfiles": [
        {
         "Type": "Video",
         "Codec": "hevc",
         "Conditions": [
          {
           "Condition": "LessThanEqual",
           "Property": "Width",
           "Value": "100",
           "IsRequired": true
          }
         ]
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.MediaSources[0].SupportsTranscoding",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "VideoResolutionNotSupported"
      }
     ]
    }
   },
