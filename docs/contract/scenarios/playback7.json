         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "Protocol": "hls",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Context": "Streaming"
        }
       ],
       "CodecProfiles": [
        {
         "Type": "Video",
         "Conditions": [
          {
