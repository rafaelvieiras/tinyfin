 {
  "id": "playback.offer.default-audio",
  "endpoint": "POST /Items/{itemId}/PlaybackInfo",
  "spec": "playback.md#offer",
  "scope": "modern",
  "tags": [
   "playback"
  ],
  "covers": [
   "playback.offer.R18"
  ],
  "requires": [
   "library:matrix2",
   "item:mx2-h264"
  ],
  "steps": [
   {
    "name": "no default audio track: its codec does not restrict direct play",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.mx2-h264.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.mx2-h264.id}}"
     },
     "body": {
      "DeviceProfile": {
       "DirectPlayProfiles": [
        {
         "Container": "mkv",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "ac3"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "Protocol": "hls",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Context": "Streaming"
        }
       ],
       "CodecProfiles": []
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": true
      }
     ]
    }
   },
   {
    "name": "no default audio track: the transcode reasons name the audio codec",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.mx2-h264.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.mx2-h264.id}}"
     },
     "body": {
      "DeviceProfile": {
       "DirectPlayProfiles": [
        {
         "Container": "mp4",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "Protocol": "hls",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Context": "Streaming"
        }
       ],
       "CodecProfiles": []
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "TranscodeReasons=ContainerNotSupported,AudioCodecNotSupported"
      }
     ]
    }
   }
  ]
 }
]