  {
    "id": "playstate.session.transcoding-info-container",
    "endpoint": "GET /Sessions",
    "spec": "playstate.md#session-state",
    "scope": "modern",
    "tags": [
      "playstate",
      "transcode"
    ],
    "covers": [
      "playstate.session.R17"
    ],
    "requires": [
      "library:avtrack",
      "item:av-multi",
      "item:av-plain"
    ],
    "steps": [
      {
        "name": "register the session",
        "as": "admin",
        "request": {
          "method": "POST",
          "path": "/Sessions/Capabilities/Full",
          "body": {
            "PlayableMediaTypes": [
              "Video"
            ],
            "SupportedCommands": []
          }
        },
        "expect": {
          "status": 204
        }
      },
      {
        "name": "forget the previous stream",
        "as": "admin",
        "request": {
          "method": "POST",
          "path": "/Sessions/Playing/Stopped",
          "body": {
            "ItemId": "{{item.av-multi.id}}",
            "PlaySessionId": "cont-ts"
          }
        },
        "expect": {
          "status": 204
        }
      },
      {
        "name": "transcode, SegmentContainer ts, .ts: request the first segment",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Videos/{{item.av-multi.id}}/hls1/main/0.ts?MediaSourceId={{item.av-multi.id}}&PlaySessionId=cont-ts&DeviceId={{device.admin}}&SegmentLength=3&SegmentContainer=ts&VideoCodec=h264&AudioCodec=aac&MaxWidth=160&VideoBitrate=500000&runtimeTicks=0&actualSegmentLengthTicks=30000000"
        },
        "expect": {
          "status": 200
        }
      },
      {
        "name": "transcode, SegmentContainer ts, .ts: the session",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Sessions",
          "query": {
            "deviceId": "{{device.admin}}"
          }
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$[0].TranscodingInfo.Container",
              "op": "eq",
              "value": "ts"
            },
            {
              "path": "$[0].TranscodingInfo.IsVideoDirect",
