        "request": {
          "method": "POST",
          "path": "/Users/New",
          "bodyRaw": "{bad",
          "headers": {
            "Content-Type": "application/json"
          }
        },
        "expect": {
          "status": 400,
          "problem": 400,
          "json": [
            {
              "path": "$.errors",
              "op": "type",
              "value": "object"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "wire.problem.api-key-is-not-a-user",
