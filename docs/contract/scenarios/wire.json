[
  {
    "id": "wire.id.user-objects",
    "endpoint": "GET /Users",
    "spec": "wire.md#id",
    "scope": "modern",
    "covers": [
      "wire.id.R1"
    ],
    "requires": [
      "user:alice"
    ],
    "steps": [
      {
        "name": "login result",
        "request": {
          "method": "POST",
          "path": "/Users/AuthenticateByName",
          "body": {
            "Username": "{{user.alice.name}}",
            "Pw": "{{user.alice.password}}"
          },
          "headers": {
            "Authorization": "MediaBrowser Client=\"Conformance\", Device=\"Conformance\", DeviceId=\"sc-wire-id-user-objects{{run.suffix}}\", Version=\"1.0.0\""
          }
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$.User.Id",
              "op": "hex32"
            },
            {
              "path": "$.User.ServerId",
              "op": "hex32"
            },
            {
              "path": "$.ServerId",
              "op": "hex32"
            },
            {
              "path": "$.SessionInfo.UserId",
              "op": "hex32"
            }
          ]
        }
      },
      {
        "name": "user list",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Users"
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$[*].Id",
              "op": "hex32"
            },
            {
              "path": "$[*].ServerId",
              "op": "hex32"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "wire.id.item-objects",
