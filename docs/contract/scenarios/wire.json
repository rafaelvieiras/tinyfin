      },
      {
        "name": "malformed item id in the path",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Items/not-a-guid"
        },
        "expect": {
          "status": 400,
          "problem": 400,
          "json": [
            {
              "path": "$.errors",
              "op": "type",
              "value": "object"
            }
          ]
        }
      },
      {
        "name": "body that is not JSON",
