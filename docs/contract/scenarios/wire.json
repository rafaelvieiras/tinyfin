      },
      {
        "name": "one item",
        "as": "admin",
        "request": {
          "method": "GET",
          "path": "/Items/{{item.alpha.id}}",
          "query": {
            "userId": "{{user.admin.id}}"
          }
        },
        "expect": {
          "status": 200,
          "json": [
            {
              "path": "$.Id",
              "op": "hex32"
            },
            {
              "path": "$.ServerId",
              "op": "hex32"
            }
          ]
        }
      }
    ]
  },
  {
