 {
  "id": "extras.local.folder-shape",
  "endpoint": "GET /Items/{itemId}/LocalTrailers",
  "spec": "extras.md#shape",
  "scope": "modern",
  "tags": [
   "extras"
  ],
  "covers": [
   "extras.find.R8"
  ],
  "requires": [
   "item:ex-shape-plain",
   "item:ex-shape-root",
   "library:extras"
  ],
  "steps": [
   {
    "name": "a movie in a folder item keeps what its extras folders hold",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.ex-shape-plain.id}}/LocalTrailers"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$",
       "op": "len",
       "value": 1
      },
      {
       "path": "$[0].Name",
       "op": "eq",
       "value": "Plain"
      }
     ]
    }
   },
   {
    "name": "and its theme",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.ex-shape-plain.id}}/ThemeSongs"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 1
      }
     ]
    }
   },
   {
    "name": "but loses everything when a '-trailer' file sits beside it",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.ex-shape-root.id}}/LocalTrailers"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$",
       "op": "len",
       "value": 0
      }
     ]
    }
   },
   {
    "name": "theme included",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.ex-shape-root.id}}/ThemeSongs"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 0
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "extras.theme.songs-and-videos",
  "endpoint": "GET /Items/{itemId}/ThemeSongs",
  "spec": "extras.md#themes",
  "scope": "modern",
  "tags": [
   "extras"
  ],
  "covers": [
   "extras.theme.R1",
   "extras.theme.R2",
   "extras.theme.R4"
  ],
  "requires": [
   "item:ex-all",
   "library:extras"
  ],
  "steps": [
   {
    "name": "theme.mp3 and theme-music/*.mp3, not the video in theme-music",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.ex-all.id}}/ThemeSongs"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.OwnerId",
       "op": "eq",
       "value": "{{item.ex-all.id}}"
      },
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.StartIndex",
       "op": "eq",
       "value": 0
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "Second Theme"
      },
      {
       "path": "$.Items[1].Name",
       "op": "eq",
       "value": "Theme Song"
      },
      {
       "path": "$.Items[0].Type",
       "op": "eq",
       "value": "Audio"
      },
      {
       "path": "$.Items[0].ExtraType",
       "op": "eq",
       "value": "ThemeSong"
      },
      {
       "path": "$.Items[0].MediaType",
       "op": "eq",
       "value": "Audio"
      }
     ]
    }
   },
   {
    "name": "videos of backdrops/",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.ex-all.id}}/ThemeVideos"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "Loop"
      },
      {
       "path": "$.Items[0].Type",
       "op": "eq",
       "value": "Video"
      },
      {
       "path": "$.Items[0].ExtraType",
       "op": "eq",
       "value": "ThemeVideo"
      }
     ]
    }
   },
   {
    "name": "both at once",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.ex-all.id}}/ThemeMedia"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.ThemeSongsResult.TotalRecordCount",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.ThemeVideosResult.TotalRecordCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.SoundtrackSongsResult.TotalRecordCount",
       "op": "eq",
       "value": 0
      },
      {
       "path": "$.ThemeSongsResult.OwnerId",
       "op": "eq",
       "value": "{{item.ex-all.id}}"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "extras.theme.inherit",
  "endpoint": "GET /Items/{itemId}/ThemeSongs",
  "spec": "extras.md#themes",
  "scope": "modern",
  "tags": [
   "extras"
  ],
  "covers": [
   "extras.theme.R3",
   "extras.series.R1"
  ],
  "requires": [
   "item:extra-show",
   "item:extra-season1",
   "item:extra-ep1",
   "library:extrashows"
  ],
  "steps": [
   {
    "name": "a series has its own theme",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.extra-show.id}}/ThemeSongs"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.OwnerId",
       "op": "eq",
       "value": "{{item.extra-show.id}}"
      }
     ]
    }
   },
   {
    "name": "an episode has none",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.extra-ep1.id}}/ThemeSongs"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 0
      },
      {
       "path": "$.OwnerId",
       "op": "eq",
       "value": "{{item.extra-ep1.id}}"
      }
     ]
    }
   },
   {
    "name": "with InheritFromParent the closest owner that has some answers",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.extra-ep1.id}}/ThemeSongs",
     "query": {
      "InheritFromParent": "true"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.OwnerId",
       "op": "eq",
       "value": "{{item.extra-season1.id}}"
      }
     ]
    }
   },
   {
    "name": "videos come from the series when the season has none",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.extra-ep1.id}}/ThemeVideos",
     "query": {
      "InheritFromParent": "true"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.OwnerId",
       "op": "eq",
       "value": "{{item.extra-show.id}}"
      }
     ]
    }
   },
   {
    "name": "ThemeMedia inherits the same way",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.extra-ep1.id}}/ThemeMedia",
     "query": {
      "InheritFromParent": "true"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.ThemeSongsResult.OwnerId",
       "op": "eq",
       "value": "{{item.extra-season1.id}}"
      },
      {
       "path": "$.ThemeVideosResult.OwnerId",
       "op": "eq",
       "value": "{{item.extra-show.id}}"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "extras.series.series-and-season",
  "endpoint": "GET /Items/{itemId}/LocalTrailers",
  "spec": "extras.md#series",
  "scope": "modern",
  "tags": [
   "extras"
  ],
  "covers": [
   "extras.series.R1",
   "extras.counts.R1"
  ],
  "requires": [
   "item:extra-show",
   "item:extra-season1",
   "item:extra-ep1",
   "library:extrashows"
  ],
  "steps": [
   {
    "name": "a series' trailers",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.extra-show.id}}/LocalTrailers"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$",
       "op": "len",
       "value": 1
      },
      {
       "path": "$[0].Name",
       "op": "eq",
       "value": "Show"
      }
     ]
    }
   },
   {
    "name": "a series' features: the folder file and the '-featurette' named like the series",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.extra-show.id}}/SpecialFeatures"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$",
       "op": "len",
       "value": 2
      },
      {
       "path": "$[0].Name",
       "op": "eq",
       "value": "Featurette"
      },
      {
       "path": "$[1].Name",
       "op": "eq",
       "value": "Show Extra"
      }
     ]
    }
   },
   {
    "name": "a season's own",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.extra-season1.id}}/LocalTrailers"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$",
       "op": "len",
       "value": 1
      },
      {
       "path": "$[0].Name",
       "op": "eq",
       "value": "Season"
      }
     ]
    }
   },
   {
    "name": "a season's features: its folder and the episode-named '-featurette'",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.extra-season1.id}}/SpecialFeatures"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$",
       "op": "len",
       "value": 2
      },
      {
       "path": "$[0].Name",
       "op": "eq",
       "value": "Extra Show S01E01"
      },
      {
       "path": "$[1].Name",
       "op": "eq",
       "value": "Season Extra"
      }
     ]
    }
   },
   {
    "name": "an episode has none",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.extra-ep1.id}}/LocalTrailers"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$",
       "op": "len",
       "value": 0
      }
     ]
    }
   },
   {
    "name": "counts on the series",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.extra-show.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.LocalTrailerCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.SpecialFeatureCount",
       "op": "eq",
       "value": 2
      }
     ]
    }
   },
   {
    "name": "counts on the season",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.extra-season1.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.LocalTrailerCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.SpecialFeatureCount",
       "op": "eq",
       "value": 2
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "extras.item.hidden-from-listings",
  "endpoint": "GET /Items",
  "spec": "extras.md#item",
  "scope": "modern",
  "tags": [
   "extras"
  ],
  "covers": [
   "extras.item.R1",
   "extras.audio.R1"
  ],
  "requires": [
   "item:ex-all",
   "library:extras",
   "item:ex-all"
  ],
  "steps": [
   {
    "name": "an extra",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.ex-all.id}}/LocalTrailers"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[0].Id",
       "op": "hex32"
      }
     ]
    },
    "capture": {
     "extra": "$[0].Id"
    }
   },
   {
    "name": "no trailer, video or audio item appears in a recursive listing of the library",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "ParentId": "{{library.extras.id}}",
      "IncludeItemTypes": "Trailer,Audio,Video"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 0
      }
     ]
    }
   },
   {
    "name": "trailers are not counted",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/Counts"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TrailerCount",
       "op": "eq",
       "value": 0
      }
     ]
    }
   },
   {
    "name": "an extra is found by its id",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Ids": "{{capture.extra}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 1
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
