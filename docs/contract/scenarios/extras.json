[
 {
  "id": "extras.local.trailers",
  "endpoint": "GET /Items/{itemId}/LocalTrailers",
  "spec": "extras.md#find",
  "scope": "modern",
  "tags": [
   "extras"
  ],
  "covers": [
   "extras.find.R1",
   "extras.find.R4",
   "extras.item.R2",
   "extras.routes.R1"
  ],
  "requires": [
   "item:ex-all",
   "library:extras"
  ],
  "steps": [
   {
    "name": "a trailers folder and a '-trailer' file",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.ex-all.id}}/LocalTrailers"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$",
       "op": "len",
       "value": 2
      },
      {
       "path": "$[0].Name",
       "op": "eq",
       "value": "Folder"
      },
      {
       "path": "$[1].Name",
       "op": "eq",
       "value": "Trailer"
      },
      {
       "path": "$[0].Type",
       "op": "eq",
       "value": "Trailer"
      },
      {
       "path": "$[0].ExtraType",
       "op": "eq",
       "value": "Trailer"
      },
      {
       "path": "$[0].IsFolder",
       "op": "eq",
       "value": false
      },
      {
       "path": "$[0].MediaType",
       "op": "eq",
       "value": "Video"
      },
      {
       "path": "$[0].Id",
       "op": "hex32"
      },
      {
       "path": "$[0].MediaSources",
       "op": "len",
       "value": 1
      },
      {
       "path": "$[0].RunTimeTicks",
       "op": "exists"
      }
     ]
    },
    "capture": {
     "trailer": "$[0].Id"
    }
   },
   {
    "name": "the extra is an item of its own",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{capture.trailer}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Type",
       "op": "eq",
       "value": "Trailer"
      },
      {
       "path": "$.ExtraType",
       "op": "eq",
       "value": "Trailer"
      },
      {
       "path": "$.Name",
       "op": "eq",
       "value": "Folder"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
