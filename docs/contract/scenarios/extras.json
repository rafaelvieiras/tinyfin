 {
  "id": "extras.parts.stacked",
  "endpoint": "GET /Videos/{itemId}/AdditionalParts",
  "spec": "extras.md#parts",
  "scope": "modern",
  "tags": [
   "extras"
  ],
  "covers": [
   "extras.parts.R1"
  ],
  "requires": [
   "item:ex-parts",
   "library:extras"
  ],
  "steps": [
   {
    "name": "three parts are one movie",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.ex-parts.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.PartCount",
       "op": "eq",
       "value": 3
      },
      {
       "path": "$.Name",
       "op": "eq",
       "value": "Ex Parts (2224)"
      },
      {
       "path": "$.MediaSources",
       "op": "len",
       "value": 1
      }
     ]
    }
   },
   {
    "name": "the other two are listed apart",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Videos/{{item.ex-parts.id}}/AdditionalParts"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.StartIndex",
       "op": "eq",
       "value": 0
      },
      {
       "path": "$.Items",
       "op": "len",
       "value": 2
      },
      {
       "path": "$.Items[0].Type",
       "op": "eq",
       "value": "Video"
      },
      {
       "path": "$.Items[0].ExtraType",
       "op": "absent"
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "Ex Parts (2224) - part2"
      },
      {
       "path": "$.Items[0].Id",
       "op": "hex32"
      }
     ]
    }
   },
   {
    "name": "and are not movies of the library",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "Movie",
      "ParentId": "{{library.extras.id}}",
      "SearchTerm": "Ex Parts"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 1
      }
     ]
    }
   },
   {
    "name": "a movie that is not stacked has no part count",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.ex-all.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.PartCount",
       "op": "absent"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "extras.versions.movie",
  "endpoint": "GET /Items/{itemId}",
  "spec": "extras.md#versions",
  "scope": "modern",
  "tags": [
   "extras"
  ],
  "covers": [
   "extras.versions.R1"
  ],
  "requires": [
   "item:ex-versions",
   "library:extras"
  ],
  "steps": [
   {
    "name": "a second file named after the movie is a version: one more media source",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.ex-versions.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources",
       "op": "len",
       "value": 2
      },
      {
       "path": "$.MediaSources[0].Name",
       "op": "eq",
       "value": "Ex Versions (2225)"
      },
      {
       "path": "$.MediaSources[1].Name",
       "op": "eq",
       "value": "4K"
      },
      {
       "path": "$.MediaSources[1].Id",
       "op": "hex32"
      }
     ]
    }
   },
   {
    "name": "PlaybackInfo lists both",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.ex-versions.id}}/PlaybackInfo"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources",
       "op": "len",
       "value": 2
      }
     ]
    }
   },
   {
    "name": "and the movie is the only one",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "Movie",
      "ParentId": "{{library.extras.id}}",
      "SearchTerm": "Ex Versions"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 1
      }
     ]
    }
   }
  ],
  "cleanup": []
 }
]