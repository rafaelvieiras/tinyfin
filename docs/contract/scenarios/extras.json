 {
  "id": "extras.local.counts",
  "endpoint": "GET /Items/{itemId}",
  "spec": "extras.md#counts",
  "scope": "modern",
  "tags": [
   "extras"
  ],
  "covers": [
   "extras.counts.R1"
  ],
  "requires": [
   "item:ex-all",
   "item:alpha",
   "library:extras"
  ],
  "steps": [
   {
    "name": "a single read carries the counts",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.ex-all.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.LocalTrailerCount",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.SpecialFeatureCount",
       "op": "eq",
       "value": 11
      }
     ]
    }
   },
   {
    "name": "a listing carries them when Fields asks",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Ids": "{{item.ex-all.id}}",
      "Fields": "LocalTrailerCount,SpecialFeatureCount"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[0].LocalTrailerCount",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.Items[0].SpecialFeatureCount",
       "op": "eq",
       "value": 11
      }
     ]
    }
   },
   {
    "name": "and leaves them out otherwise",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Ids": "{{item.ex-all.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[0].LocalTrailerCount",
       "op": "absent"
      }
     ]
    }
   },
   {
    "name": "a movie without extras says zero",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.alpha.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.LocalTrailerCount",
       "op": "eq",
       "value": 0
      },
      {
       "path": "$.SpecialFeatureCount",
       "op": "eq",
       "value": 0
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
