 {
  "id": "extras.local.not-extras",
  "endpoint": "GET /Items",
  "spec": "extras.md#find",
  "scope": "modern",
  "tags": [
   "extras"
  ],
  "covers": [
   "extras.find.R6"
  ],
  "requires": [
   "item:ex-hidden",
   "library:extras"
  ],
  "steps": [
   {
    "name": "'.featurette', '-featurettes' and '.sample' files are no extras and no movies",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.ex-hidden.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.LocalTrailerCount",
       "op": "eq",
       "value": 0
      },
      {
       "path": "$.SpecialFeatureCount",
       "op": "eq",
       "value": 0
      }
     ]
    }
   },
   {
    "name": "the movie of that folder is the only one named like it",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "Movie",
      "ParentId": "{{library.extras.id}}",
      "SearchTerm": "Ex Hidden"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 1
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
