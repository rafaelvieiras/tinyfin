[
 {
  "id": "users.update.provider-ids-from-lists",
  "endpoint": "POST /Users",
  "spec": "users.md#update",
  "scope": "modern",
  "tags": [
   "users"
  ],
  "covers": [
   "users.update.R14"
  ],
  "steps": [
   {
    "name": "create",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Users/New",
     "body": {
      "Name": "tmp-update-providers",
      "Password": "Tmp-Pass-1"
     }
    },
    "expect": {
     "status": 200
    },
    "capture": {
     "u": "$.Id"
    }
   },
   {
    "name": "authentication providers",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Auth/Providers"
    },
    "expect": {
     "status": 200
    },
    "capture": {
     "ap": "$[0].Id"
    }
   },
   {
    "name": "reset providers",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Auth/PasswordResetProviders"
    },
    "expect": {
     "status": 200
    },
    "capture": {
     "rp": "$[0].Id"
    }
   },
   {
    "name": "save the profile with the listed providers",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Users?userId={{capture.u}}",
     "body": {
      "Name": "tmp-update-providers",
      "Policy": {
       "AuthenticationProviderId": "{{capture.ap}}",
       "PasswordResetProviderId": "{{capture.rp}}"
      }
     }
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "policy saved with the listed providers",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Users/{{capture.u}}/Policy",
     "body": {
      "AuthenticationProviderId": "{{capture.ap}}",
      "PasswordResetProviderId": "{{capture.rp}}",
      "IsHidden": true
     }
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "read back",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Users/{{capture.u}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Policy.AuthenticationProviderId",
       "op": "eq",
       "value": "{{capture.ap}}"
      },
      {
       "path": "$.Policy.PasswordResetProviderId",
       "op": "eq",
       "value": "{{capture.rp}}"
      }
     ]
    }
   }
  ],
  "cleanup": [
   {
    "name": "delete u",
    "as": "admin",
    "request": {
     "method": "DELETE",
     "path": "/Users/{{capture.u}}"
    },
    "expect": {}
   }
  ]
 },
 {
  "id": "users.password.reset-lowercase-key",
  "endpoint": "POST /Users/{userId}/Password",
  "spec": "users.md#update-password",
  "scope": "modern",
  "tags": [
   "security"
  ],
  "covers": [
   "users.password.R15"
  ],
  "steps": [
   {
    "name": "create",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Users/New",
     "body": {
      "Name": "tmp-password-lc",
      "Password": "Tmp-Pass-1"
     }
    },
    "expect": {
     "status": 200
    },
    "capture": {
     "u": "$.Id"
    }
   },
   {
    "name": "reset with a lower-case member name",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Users/{{capture.u}}/Password",
     "body": {
      "resetPassword": true
     }
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "empty Pw logs in",
    "as": "anonymous",
    "request": {
     "method": "POST",
     "path": "/Users/AuthenticateByName",
     "body": {
      "Username": "tmp-password-lc",
      "Pw": ""
     },
     "headers": {
      "Authorization": "MediaBrowser Client=\"Conformance\", Device=\"Conformance\", DeviceId=\"sc-lc-empty-Pw-logs-in{{run.suffix}}\", Version=\"1.0.0\""
     }
    },
    "expect": {
     "status": 200
    }
   },
   {
    "name": "old Pw is rejected",
    "as": "anonymous",
    "request": {
     "method": "POST",
     "path": "/Users/AuthenticateByName",
     "body": {
      "Username": "tmp-password-lc",
      "Pw": "Tmp-Pass-1"
     },
     "headers": {
      "Authorization": "MediaBrowser Client=\"Conformance\", Device=\"Conformance\", DeviceId=\"sc-lc-old-Pw-is-rejected{{run.suffix}}\", Version=\"1.0.0\""
     }
    },
    "expect": {
     "status": 401
    }
   },
   {
    "name": "set with lower-case member names",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Users/{{capture.u}}/Password",
     "body": {
      "currentPw": "",
      "newPw": "Tmp-Pass-2"
     }
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "new Pw logs in",
    "as": "anonymous",
    "request": {
     "method": "POST",
     "path": "/Users/AuthenticateByName",
     "body": {
      "Username": "tmp-password-lc",
      "Pw": "Tmp-Pass-2"
     },
     "headers": {
      "Authorization": "MediaBrowser Client=\"Conformance\", Device=\"Conformance\", DeviceId=\"sc-lc-new-Pw-logs-in{{run.suffix}}\", Version=\"1.0.0\""
     }
    },
    "expect": {
     "status": 200
    }
   },
   {
    "name": "empty Pw is rejected",
    "as": "anonymous",
    "request": {
     "method": "POST",
     "path": "/Users/AuthenticateByName",
     "body": {
      "Username": "tmp-password-lc",
      "Pw": ""
     },
     "headers": {
      "Authorization": "MediaBrowser Client=\"Conformance\", Device=\"Conformance\", DeviceId=\"sc-lc-empty-Pw-is-rejected{{run.suffix}}\", Version=\"1.0.0\""
     }
    },
    "expect": {
     "status": 401
    }
   }
  ],
  "cleanup": [
   {
    "name": "delete u",
    "as": "admin",
    "request": {
     "method": "DELETE",
     "path": "/Users/{{capture.u}}"
    },
    "expect": {}
   }
  ]
 },
 {
  "id": "items.views.alias",
  "endpoint": "GET /Users/{userId}/Views",
  "spec": "items.md#views",
  "scope": "modern",
  "requires": [
   "library:movies",
   "library:shows"
  ],
  "covers": [
   "items.views.R1",
   "items.views.R2"
  ],
  "steps": [
   {
    "name": "a user to ask for",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Users/New",
     "body": {
      "Name": "tmp-views-alias",
      "Password": "Tmp-Pass-1"
     }
    },
    "expect": {
     "status": 200
    },
    "capture": {
     "u": "$.Id"
    }
   },
   {
    "name": "login tmp-views-alias",
    "request": {
     "method": "POST",
     "path": "/Users/AuthenticateByName",
     "body": {
      "Username": "tmp-views-alias",
      "Pw": "Tmp-Pass-1"
     },
     "headers": {
      "Authorization": "MediaBrowser Client=\"Conformance\", Device=\"Conformance\", DeviceId=\"sc-views-alias{{run.suffix}}\", Version=\"1.0.0\""
     }
    },
    "expect": {
     "status": 200
    },
    "capture": {
     "tok": "$.AccessToken"
    }
   },
   {
    "name": "the legacy path answers the caller's own views",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "GET",
     "path": "/Users/{{capture.u}}/Views"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[*].Name",
       "op": "sequence",
       "value": [
        "Movies",
        "Shows"
       ]
      }
     ]
    }
   },
   {
    "name": "an administrator may ask for another user's views",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Users/{{capture.u}}/Views"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[*].Name",
       "op": "sequence",
       "value": [
        "Movies",
        "Shows"
       ]
      }
     ]
    }
   },
   {
    "name": "another user's views are refused",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "GET",
     "path": "/Users/{{user.admin.id}}/Views"
    },
    "expect": {
     "status": 403
    }
   },
   {
    "name": "an identifier that names nobody is not found",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Users/0123456789abcdef0123456789abcdef/Views"
    },
    "expect": {
     "status": 404
    }
   },
   {
    "name": "anonymous is unauthorized",
    "request": {
     "method": "GET",
     "path": "/Users/{{capture.u}}/Views"
    },
    "expect": {
     "status": 401
    }
   },
   {
    "name": "UserViews takes the same user parameter",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "GET",
     "path": "/UserViews?userId={{capture.u}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[*].Name",
       "op": "sequence",
       "value": [
        "Movies",
        "Shows"
       ]
      }
     ]
    }
   },
   {
    "name": "UserViews refuses another user's views",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "GET",
     "path": "/UserViews?userId={{user.admin.id}}"
    },
    "expect": {
     "status": 403
    }
   },
   {
    "name": "UserViews answers 403, not 404, for an unknown user",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "GET",
     "path": "/UserViews?userId=0123456789abcdef0123456789abcdef"
    },
    "expect": {
     "status": 403
    }
   }
  ],
  "cleanup": [
   {
    "name": "remove tmp-views-alias",
    "as": "admin",
    "request": {
     "method": "DELETE",
     "path": "/Users/{{capture.u}}"
    },
    "expect": {}
   }
  ]
 },
 {
  "id": "items.grouping.options",
  "endpoint": "GET /UserViews/GroupingOptions, GET /Users/{userId}/GroupingOptions",
  "spec": "items.md#grouping",
  "scope": "modern",
  "requires": [
   "library:movies",
   "library:shows",
   "library:music"
  ],
  "covers": [
   "items.grouping.R1",
   "items.grouping.R2",
   "items.grouping.R4"
  ],
  "steps": [
   {
    "name": "the groupable libraries, in name order",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/UserViews/GroupingOptions"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[*].Name",
       "op": "sequence",
       "value": [
        "Movies",
        "Shows"
       ]
      },
      {
       "path": "$[?Name=Music]",
       "op": "absent"
      },
      {
       "path": "$[*].Id",
       "op": "hex32"
      }
     ]
    }
   },
   {
    "name": "the legacy form answers the same list",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Users/{{user.admin.id}}/GroupingOptions"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[*].Name",
       "op": "sequence",
       "value": [
        "Movies",
        "Shows"
       ]
      },
      {
       "path": "$[?Name=Music]",
       "op": "absent"
      }
     ]
    }
   },
   {
    "name": "an identifier that names nobody falls back to the caller",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/UserViews/GroupingOptions?userId=00000000000000000000000000000000"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[*].Name",
       "op": "sequence",
       "value": [
        "Movies",
        "Shows"
       ]
      },
      {
       "path": "$[?Name=Music]",
       "op": "absent"
      }
     ]
    }
   },
   {
    "name": "a value that is not an identifier is a validation error",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/UserViews/GroupingOptions?userId=nope"
    },
    "expect": {
     "status": 400,
     "problem": 400
    }
   },
   {
    "name": "the legacy form rejects it the same way",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Users/nope/GroupingOptions"
    },
    "expect": {
     "status": 400,
     "problem": 400
    }
   },
   {
    "name": "anonymous is refused",
    "request": {
     "method": "GET",
     "path": "/UserViews/GroupingOptions"
    },
    "expect": {
     "status": 401
    }
   },
   {
    "name": "a user to ask with",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Users/New",
     "body": {
      "Name": "tmp-grouping",
      "Password": "Tmp-Pass-1"
     }
    },
    "expect": {
     "status": 200
    },
    "capture": {
     "u": "$.Id"
    }
   },
   {
    "name": "log tmp-grouping in",
    "request": {
     "method": "POST",
     "path": "/Users/AuthenticateByName",
     "body": {
      "Username": "tmp-grouping",
      "Pw": "Tmp-Pass-1"
     },
     "headers": {
      "Authorization": "MediaBrowser Client=\"Conformance\", Device=\"Conformance\", DeviceId=\"sc-grouping{{run.suffix}}\", Version=\"1.0.0\""
     }
    },
    "expect": {
     "status": 200
    },
    "capture": {
     "tok": "$.AccessToken"
    }
   },
   {
    "name": "another user's options are refused to a non-administrator",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "GET",
     "path": "/Users/{{user.admin.id}}/GroupingOptions"
    },
    "expect": {
     "status": 403
    }
   },
   {
    "name": "and to the query form of the route",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "GET",
     "path": "/UserViews/GroupingOptions?userId={{user.admin.id}}"
    },
    "expect": {
     "status": 403
    }
   },
   {
    "name": "their own options are their own",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "GET",
     "path": "/Users/{{capture.u}}/GroupingOptions"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[*].Name",
       "op": "sequence",
       "value": [
        "Movies",
        "Shows"
       ]
      }
     ]
    }
   }
  ]
 },
 {
  "id": "users.preferences.save",
  "endpoint": "POST /Users/{userId}/Configuration",
  "spec": "users.md#configuration",
  "scope": "modern",
  "requires": [
   "library:movies",
   "library:shows",
   "item:alpha"
  ],
  "covers": [
   "items.views.R6",
   "items.views.R7",
   "items.latest.R1",
   "items.latest.R2",
   "items.latest.R3",
   "users.configuration.R15"
  ],
  "steps": [
   {
    "name": "a user whose preferences the page edits",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Users/New",
     "body": {
      "Name": "tmp-prefs",
      "Password": "Tmp-Pass-1"
     }
    },
    "expect": {
     "status": 200
    },
    "capture": {
     "u": "$.Id"
    }
   },
   {
    "name": "login tmp-prefs",
    "request": {
     "method": "POST",
     "path": "/Users/AuthenticateByName",
     "body": {
      "Username": "tmp-prefs",
      "Pw": "Tmp-Pass-1"
     },
     "headers": {
      "Authorization": "MediaBrowser Client=\"Conformance\", Device=\"Conformance\", DeviceId=\"sc-prefs{{run.suffix}}\", Version=\"1.0.0\""
     }
    },
    "expect": {
     "status": 200
    },
    "capture": {
     "tok": "$.AccessToken"
    }
   },
   {
    "name": "the page's own load lists the libraries",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "GET",
     "path": "/UserViews"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[*].Name",
       "op": "sequence",
       "value": [
        "Movies",
        "Shows"
       ]
      }
     ]
    }
   },
   {
    "name": "the page saves a new order",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "POST",
     "path": "/Users/{{capture.u}}/Configuration",
     "body": {
      "OrderedViews": [
       "{{library.shows.id}}",
       "{{library.movies.id}}"
      ]
     }
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "the home screen gets the saved order",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "GET",
     "path": "/UserViews"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[*].Name",
       "op": "sequence",
       "value": [
        "Shows",
        "Movies"
       ]
      }
     ]
    }
   },
   {
    "name": "the legacy view route gets it too",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "GET",
     "path": "/Users/{{capture.u}}/Views"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[*].Name",
       "op": "sequence",
       "value": [
        "Shows",
        "Movies"
       ]
      }
     ]
    }
   },
   {
    "name": "the grouping options keep their own order",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "GET",
     "path": "/UserViews/GroupingOptions"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[*].Name",
       "op": "sequence",
       "value": [
        "Movies",
        "Shows"
       ]
      }
     ]
    }
   },
   {
    "name": "the page unchecks a library from My Media",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "POST",
     "path": "/Users/{{capture.u}}/Configuration",
     "body": {
      "OrderedViews": [
       "{{library.shows.id}}",
       "{{library.movies.id}}"
      ],
      "MyMediaExcludes": [
       "{{library.movies.id}}"
      ]
     }
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "the unchecked library is not in the home screen",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "GET",
     "path": "/UserViews"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Movies"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Shows"
      }
     ]
    }
   },
   {
    "name": "includeHidden lists it again, in the saved order",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "GET",
     "path": "/UserViews?includeHidden=true"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[*].Name",
       "op": "sequence",
       "value": [
        "Shows",
        "Movies"
       ]
      }
     ]
    }
   },
   {
    "name": "the legacy route takes includeHidden too",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "GET",
     "path": "/Users/{{capture.u}}/Views?includeHidden=true"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[*].Name",
       "op": "sequence",
       "value": [
        "Shows",
        "Movies"
       ]
      }
     ]
    }
   },
   {
    "name": "a value that is not a boolean is refused",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "GET",
     "path": "/UserViews?includeHidden=1"
    },
    "expect": {
     "status": 400,
     "problem": 400
    }
   },
   {
    "name": "a watched movie is marked",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "POST",
     "path": "/Users/{{capture.u}}/PlayedItems/{{item.alpha.id}}"
    },
    "expect": {
     "status": 200
    }
   },
   {
    "name": "watched media leaves the latest row",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "GET",
     "path": "/Items/Latest?limit=30"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Alpha Movie (2015)"
      }
     ]
    }
   },
   {
    "name": "turning the preference off brings it back",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "POST",
     "path": "/Users/{{capture.u}}/Configuration",
     "body": {
      "OrderedViews": [
       "{{library.shows.id}}",
       "{{library.movies.id}}"
      ],
      "HidePlayedInLatest": false
     }
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "the played movie is in the latest row again",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "GET",
     "path": "/Items/Latest?limit=30"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[*].Name",
       "op": "contains",
       "value": "Alpha Movie (2015)"
      }
     ]
    }
   },
   {
    "name": "the page unchecks a library from latest",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "POST",
     "path": "/Users/{{capture.u}}/Configuration",
     "body": {
      "HidePlayedInLatest": false,
      "LatestItemsExcludes": [
       "{{library.movies.id}}"
      ]
     }
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "that library's media leaves the latest row",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "GET",
     "path": "/Items/Latest?limit=30"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[*].Name",
       "op": "notcontains",
       "value": "Alpha Movie (2015)"
      }
     ]
    }
   },
   {
    "name": "grouped folders are stored",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "POST",
     "path": "/Users/{{capture.u}}/Configuration",
     "body": {
      "GroupedFolders": [
       "{{library.movies.id}}"
      ]
     }
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "and come back on the user",
    "as": "token:{{capture.tok}}",
    "request": {
     "method": "GET",
     "path": "/Users/{{capture.u}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Configuration.GroupedFolders[0]",
       "op": "eq",
       "value": "{{library.movies.id}}"
      }
     ]
    }
   },
   {
    "name": "another user's latest row is refused",
    "as": "alice",
    "request": {
     "method": "GET",
     "path": "/Users/{{capture.u}}/Items/Latest?limit=3"
    },
    "expect": {
     "status": 403
    }
   },
   {
    "name": "a latest row for an identifier that names nobody is not found",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Users/0123456789abcdef0123456789abcdef/Items/Latest"
    },
    "expect": {
     "status": 404
    }
   },
   {
    "name": "a malformed identifier is a bad request",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Users/nope/Items/Latest"
    },
    "expect": {
     "status": 400
    }
   },
   {
    "name": "anonymous is unauthorized",
    "request": {
     "method": "GET",
     "path": "/Users/{{capture.u}}/Items/Latest"
    },
    "expect": {
     "status": 401
    }
   }
  ],
  "cleanup": [
   {
    "name": "remove the temporary user",
    "as": "admin",
    "request": {
     "method": "DELETE",
     "path": "/Users/{{capture.u}}"
    },
    "expect": {
     "status": [
      200,
      204,
      404
     ]
    }
   }
  ]
 }
]
