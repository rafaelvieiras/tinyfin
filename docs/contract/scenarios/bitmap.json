 {
  "id": "bitmap.delivery.encode",
  "endpoint": "POST /Items/{itemId}/PlaybackInfo",
  "spec": "bitmap.md",
  "scope": "modern",
  "tags": [
   "subtitles",
   "bitmap"
  ],
  "covers": [
   "bitmap.delivery.R1",
   "bitmap.delivery.R2"
  ],
  "requires": [
   "library:bitmap",
   "item:bmp-mixed"
  ],
  "steps": [
   {
    "name": "text via Hls and files: picture tracks are burned in",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.bmp-mixed.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.bmp-mixed.id}}",
      "SubtitleStreamIndex": "3"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mkv",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "vtt",
         "Method": "Hls"
        },
        {
         "Format": "srt",
         "Method": "External"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].MediaStreams[2].DeliveryMethod",
       "op": "eq",
       "value": "Hls"
      },
      {
       "path": "$.MediaSources[0].MediaStreams[3].DeliveryMethod",
       "op": "eq",
       "value": "Encode"
      },
      {
       "path": "$.MediaSources[0].MediaStreams[4].DeliveryMethod",
       "op": "eq",
       "value": "Encode"
      },
      {
       "path": "$.MediaSources[0].MediaStreams[3].DeliveryUrl",
       "op": "absent"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "SubtitleMethod=Encode"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "SubtitleStreamIndex=3"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "TranscodeReasons=SubtitleCodecNotSupported"
      },
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": false
      }
     ]
    }
   },
   {
    "name": "an Encode entry is the same",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.bmp-mixed.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.bmp-mixed.id}}",
      "SubtitleStreamIndex": "3"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mkv",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "srt",
         "Method": "External"
        },
        {
         "Format": "srt",
         "Method": "Encode"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].MediaStreams[3].DeliveryMethod",
       "op": "eq",
       "value": "Encode"
      },
      {
       "path": "$.MediaSources[0].MediaStreams[4].DeliveryMethod",
       "op": "eq",
       "value": "Encode"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "SubtitleMethod=Encode"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "SubtitleStreamIndex=3"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "TranscodeReasons=SubtitleCodecNotSupported"
      },
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": false
      }
     ]
    }
   }
  ]
 },
 {
  "id": "bitmap.delivery.embed",
  "endpoint": "POST /Items/{itemId}/PlaybackInfo",
  "spec": "bitmap.md",
  "scope": "modern",
  "tags": [
   "subtitles",
   "bitmap"
  ],
  "covers": [
   "bitmap.delivery.R3",
   "bitmap.delivery.R4"
  ],
  "requires": [
   "library:bitmap",
   "item:bmp-mixed"
  ],
  "steps": [
   {
    "name": "the codecs named as Embed entries stay in the container",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.bmp-mixed.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.bmp-mixed.id}}",
      "SubtitleStreamIndex": "3"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mkv",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "pgssub",
         "Method": "Embed"
        },
        {
         "Format": "dvdsub",
         "Method": "Embed"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].MediaStreams[3].DeliveryMethod",
       "op": "eq",
       "value": "Embed"
      },
      {
       "path": "$.MediaSources[0].MediaStreams[4].DeliveryMethod",
       "op": "eq",
       "value": "Embed"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "absent"
      }
     ]
    }
   },
   {
    "name": "only the selected codec named: the other track is burned",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.bmp-mixed.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.bmp-mixed.id}}",
      "SubtitleStreamIndex": "3"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mkv",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "PGSSUB",
         "Method": "Embed"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].MediaStreams[3].DeliveryMethod",
       "op": "eq",
       "value": "Embed"
      },
      {
       "path": "$.MediaSources[0].MediaStreams[4].DeliveryMethod",
       "op": "eq",
       "value": "Encode"
      }
     ]
    }
   },
   {
    "name": "the selected track's codec not named: everything is transcoded",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.bmp-mixed.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.bmp-mixed.id}}",
      "SubtitleStreamIndex": "3"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mkv",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "dvdsub",
         "Method": "Embed"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.MediaSources[0].MediaStreams[3].DeliveryMethod",
       "op": "eq",
       "value": "Encode"
      },
      {
       "path": "$.MediaSources[0].MediaStreams[4].DeliveryMethod",
       "op": "eq",
       "value": "Encode"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "SubtitleMethod=Encode"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "SubtitleStreamIndex=3"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "TranscodeReasons=SubtitleCodecNotSupported"
      }
     ]
    }
   },
   {
    "name": "a container that cannot hold the track: transcoded and burned",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.bmp-pgs.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.bmp-pgs.id}}",
      "SubtitleStreamIndex": "2"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mp4",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "pgssub",
         "Method": "Embed"
        }
       ]
      }
     }
