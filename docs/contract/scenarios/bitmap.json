     "method": "POST",
     "path": "/Items/{{item.bmp-mixed.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.bmp-mixed.id}}",
      "SubtitleStreamIndex": "3"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mp4",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "vtt",
         "Method": "Hls"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": false
      }
     ]
    },
    "capture": {
     "url": "$.MediaSources[0].TranscodingUrl"
    }
   },
   {
    "name": "the master playlist",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "{{capture.url}}"
    },
    "expect": {
     "status": 200,
     "text": [
      {
       "op": "prefix",
       "value": "#EXTM3U"
      },
      {
       "op": "contains",
       "value": "#EXT-X-STREAM-INF"
      },
      {
       "op": "contains",
       "value": "SubtitleMethod=Encode"
      },
      {
       "op": "notcontains",
       "value": "TYPE=SUBTITLES"
      }
     ]
    }
   },
