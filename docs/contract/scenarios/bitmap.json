[
 {
  "id": "bitmap.streams.pgs",
  "endpoint": "GET /Items/{itemId}",
  "spec": "bitmap.md",
  "scope": "modern",
  "tags": [
   "subtitles",
   "bitmap"
  ],
  "covers": [
   "bitmap.streams.R1",
   "bitmap.streams.R2"
  ],
  "requires": [
   "library:bitmap",
   "item:bmp-pgs"
  ],
  "steps": [
   {
    "name": "an embedded PGS track",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.bmp-pgs.id}}",
     "query": {
      "Fields": "MediaSources"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].MediaStreams",
       "op": "len",
       "value": 3
      },
      {
       "path": "$.MediaSources[0].MediaStreams[2].Type",
       "op": "eq",
       "value": "Subtitle"
      },
      {
       "path": "$.MediaSources[0].MediaStreams[2].Codec",
       "op": "eq",
       "value": "PGSSUB"
      },
      {
       "path": "$.MediaSources[0].MediaStreams[2].Language",
       "op": "eq",
       "value": "eng"
      },
      {
       "path": "$.MediaSources[0].MediaStreams[2].IsDefault",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].MediaStreams[2].IsForced",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.MediaSources[0].MediaStreams[2].IsExternal",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.MediaSources[0].MediaStreams[2].IsTextSubtitleStream",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.MediaSources[0].MediaStreams[2].SupportsExternalStream",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].MediaStreams[2].Score",
       "op": "eq",
       "value": 112211
      },
      {
       "path": "$.MediaSources[0].MediaStreams[2].Width",
       "op": "eq",
       "value": 320
      },
      {
       "path": "$.MediaSources[0].MediaStreams[2].Height",
       "op": "eq",
       "value": 240
      },
      {
       "path": "$.MediaSources[0].MediaStreams[2].DisplayTitle",
       "op": "eq",
       "value": "English - Default - PGSSUB"
      }
     ]
    }
   }
  ]
 },
