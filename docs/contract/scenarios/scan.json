[
 {
  "id": "scan.ignore.empty-file",
  "endpoint": "GET /Items",
  "spec": "scan.md#ignore",
  "scope": "modern",
  "tags": [
   "scan"
  ],
  "covers": [
   "scan.ignore.R1",
   "scan.ignore.R5"
  ],
  "requires": [
   "library:ignore",
   "item:ign-plain",
   "item:ign-nomedia"
  ],
  "steps": [
   {
    "name": "a folder with an empty or blank .ignore is not cataloged, .nomedia changes nothing",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{library.ignore.id}}",
      "Recursive": "true",
      "IncludeItemTypes": "Movie",
      "Limit": "200"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Plain (2301)"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "NoMedia (2304)"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Gone (2302)"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Blank (2303)"
      }
     ]
    }
   }
  ]
 },
 {
  "id": "scan.ignore.patterns",
  "endpoint": "GET /Items",
  "spec": "scan.md#ignore",
  "scope": "modern",
  "tags": [
   "scan"
  ],
  "covers": [
   "scan.ignore.R2",
   "scan.ignore.R3",
   "scan.ignore.R4"
  ],
  "requires": [
   "library:ignore",
   "item:ign-pat-keep",
   "item:ign-pat-sub2",
   "item:ign-anch-top",
   "item:ign-anch-deep",
   "item:ign-anch-x",
   "item:ign-own-keep",
   "item:ign-own-x",
   "item:ign-neg-two",
   "item:ign-neg-db"
  ],
  "steps": [
   {
    "name": "patterns: wildcards, case, comments, a folder pattern",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{library.ignore.id}}",
      "Recursive": "true",
      "IncludeItemTypes": "Movie",
      "Limit": "200",
      "SearchTerm": "skip"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 0
      }
     ]
    }
   },
   {
    "name": "sample files of the folder with the pattern",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{library.ignore.id}}",
      "Recursive": "true",
      "IncludeItemTypes": "Movie",
      "Limit": "200",
      "SearchTerm": "sample"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 0
      }
     ]
    }
   },
   {
    "name": "a pattern applies below the folder: only the other file is left of the folder",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.ign-anch-deep.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Type",
       "op": "eq",
       "value": "Movie"
      },
      {
       "path": "$.Name",
       "op": "eq",
       "value": "a"
      },
      {
       "path": "$.Path",
       "op": "matches",
       "value": "/Anch/a/deep-keep\\.mp4$"
      }
     ]
    }
   },
   {
    "name": "the nearest .ignore alone applies: the ancestor's pattern is not inherited",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.ign-own-x.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Type",
       "op": "eq",
       "value": "Movie"
      },
      {
       "path": "$.Name",
       "op": "eq",
       "value": "x"
      },
      {
       "path": "$.Path",
       "op": "matches",
       "value": "/Own/x/two-e2\\.mp4$"
      }
     ]
    }
   },
   {
    "name": "a negated pattern keeps its file",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{library.ignore.id}}",
      "Recursive": "true",
      "IncludeItemTypes": "Movie",
      "Limit": "200",
      "SearchTerm": "da-"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.Items[0].Id",
       "op": "eq",
       "value": "{{item.ign-neg-two.id}}"
      }
     ]
    }
   },
   {
    "name": "a pattern with a slash in it never matches",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.ign-anch-x.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Type",
       "op": "eq",
       "value": "Movie"
      }
     ]
    }
   },
   {
    "name": "a folder pattern leaves its sibling folder",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.ign-pat-sub2.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Type",
       "op": "eq",
       "value": "Movie"
      }
     ]
    }
   }
  ]
 },
 {
  "id": "scan.ignore.fixed-names",
  "endpoint": "GET /Items",
  "spec": "scan.md#ignore",
  "scope": "modern",
  "tags": [
