 },
 {
  "id": "scan.disc.dvd-media",
  "endpoint": "GET /Items/{itemId}",
  "spec": "scan.md#disc",
  "scope": "modern",
  "tags": [
   "scan"
  ],
  "covers": [
   "scan.disc.R1",
   "scan.disc.R3",
   "scan.disc.R6"
  ],
  "requires": [
   "item:disc-dvd-real"
  ],
  "steps": [
   {
    "name": "a folder with a VIDEO_TS holding VOBs is one DVD movie",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.disc-dvd-real.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Type",
       "op": "eq",
       "value": "Movie"
      },
      {
       "path": "$.IsFolder",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.Name",
       "op": "eq",
       "value": "Dvd Real (2321)"
      },
      {
       "path": "$.VideoType",
       "op": "eq",
       "value": "Dvd"
      },
      {
       "path": "$.Path",
       "op": "matches",
       "value": "/Discs/Dvd Real \\(2321\\)$"
      },
      {
       "path": "$.Container",
       "op": "eq",
       "value": "mpeg"
      },
      {
       "path": "$.RunTimeTicks",
       "op": "gte",
       "value": 15000000
      },
      {
       "path": "$.RunTimeTicks",
       "op": "lte",
       "value": 30000000
      },
      {
       "path": "$.MediaSources[0].VideoType",
       "op": "eq",
       "value": "Dvd"
      },
      {
       "path": "$.MediaSources[0].Name",
       "op": "eq",
       "value": "Dvd Real (2321)/DVD"
      },
      {
       "path": "$.MediaSources[0].Protocol",
       "op": "eq",
       "value": "File"
      },
      {
       "path": "$.MediaSources[0].IsRemote",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.MediaSources[0].MediaStreams[*].Codec",
       "op": "contains",
       "value": "mpeg2video"
      },
      {
       "path": "$.MediaSources[0].MediaStreams[*].Codec",
       "op": "contains",
       "value": "ac3"
      },
      {
       "path": "$.MediaSources[0].MediaStreams[*].Type",
       "op": "contains",
       "value": "Video"
      },
      {
       "path": "$.MediaSources[0].MediaStreams[*].Type",
       "op": "contains",
       "value": "Audio"
      }
     ]
    }
   }
  ]
 },
 {
