 {
  "id": "scan.disc.image-dvd",
  "endpoint": "GET /Items/{itemId}",
  "spec": "scan.md#disc",
  "scope": "modern",
  "tags": [
   "scan"
  ],
  "covers": [
   "scan.disc.R5",
   "scan.disc.R6"
  ],
  "requires": [
   "item:disc-iso-dvd"
  ],
  "steps": [
   {
    "name": "an image that holds a DVD",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.disc-iso-dvd.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.VideoType",
       "op": "eq",
       "value": "Iso"
      },
      {
       "path": "$.IsoType",
       "op": "eq",
       "value": "Dvd"
      },
      {
       "path": "$.MediaSources[0].IsoType",
       "op": "eq",
       "value": "Dvd"
