 {
  "id": "scan.disc.placeholders",
  "endpoint": "GET /Items/{itemId}",
  "spec": "scan.md#disc",
  "scope": "modern",
  "tags": [
   "scan"
  ],
  "covers": [
   "scan.disc.R1",
   "scan.disc.R4",
   "scan.disc.R6"
  ],
  "requires": [
   "item:disc-dvd-junk",
   "item:disc-dvd-root",
   "item:disc-bd-junk",
   "item:disc-bd-nested"
  ],
  "steps": [
   {
    "name": "DVD folder with unreadable VOBs",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.disc-dvd-junk.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.VideoType",
       "op": "eq",
       "value": "Dvd"
      },
      {
       "path": "$.IsFolder",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.MediaSources[0].Name",
       "op": "eq",
       "value": "Dvd Junk (2323)/DVD"
      }
     ]
    }
   },
   {
    "name": "VIDEO_TS.IFO in the folder itself",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.disc-dvd-root.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.VideoType",
       "op": "eq",
       "value": "Dvd"
      },
      {
       "path": "$.Path",
       "op": "matches",
       "value": "/Discs/Dvd Root \\(2324\\)$"
      }
     ]
    }
   },
   {
    "name": "Blu-ray folder",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.disc-bd-junk.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.VideoType",
       "op": "eq",
       "value": "BluRay"
      },
      {
       "path": "$.IsFolder",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.Path",
       "op": "matches",
       "value": "/Discs/Bd Junk \\(2325\\)$"
      },
      {
       "path": "$.MediaSources[0].VideoType",
       "op": "eq",
       "value": "BluRay"
      },
      {
       "path": "$.MediaSources[0].Name",
       "op": "eq",
       "value": "Bd Junk (2325)/Bluray"
      }
     ]
    }
   },
   {
    "name": "Blu-ray folder below a plain folder",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.disc-bd-nested.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.VideoType",
       "op": "eq",
       "value": "BluRay"
      },
      {
       "path": "$.Name",
       "op": "eq",
       "value": "Bd Nested (2326)"
      }
     ]
    }
   }
  ]
 },
 {
  "id": "scan.disc.exclusive",
  "endpoint": "GET /Items",
  "spec": "scan.md#disc",
  "scope": "modern",
  "tags": [
   "scan"
  ],
  "covers": [
   "scan.disc.R1",
   "scan.disc.R2"
  ],
  "requires": [
   "library:discs",
   "item:disc-mixed",
   "item:disc-ifo-mp4",
   "item:disc-ifo-dir"
  ],
  "steps": [
   {
    "name": "a disc with media takes its folder, an IFO-only VIDEO_TS is a movie beside the files",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{library.discs.id}}",
      "Recursive": "true",
      "IncludeItemTypes": "Movie",
      "Limit": "200"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Mixed (2330)"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Ifo Only (2333)"
      },
      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "VIDEO_TS"
      },
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 13
      }
     ]
    }
   },
   {
    "name": "the video beside the disc is not cataloged",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.disc-mixed.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.VideoType",
       "op": "eq",
       "value": "Dvd"
      }
     ]
    }
   },
   {
    "name": "an IFO-only VIDEO_TS folder",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.disc-ifo-dir.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Name",
       "op": "eq",
       "value": "VIDEO_TS"
      },
      {
       "path": "$.VideoType",
       "op": "eq",
       "value": "Dvd"
      },
      {
       "path": "$.Path",
       "op": "matches",
       "value": "/Ifo Only \\(2333\\)/VIDEO_TS$"
      }
     ]
    }
   },
   {
    "name": "the file beside it",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.disc-ifo-mp4.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.VideoType",
       "op": "eq",
       "value": "VideoFile"
      }
     ]
    }
   }
  ]
 },
