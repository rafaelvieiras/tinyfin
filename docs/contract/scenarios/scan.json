      {
       "path": "$.Items[*].Name",
       "op": "contains",
       "value": "Backup"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "@eaDir"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "#recycle"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": ".hidden"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "Subs"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "metadata"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "lost+found"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "System Volume Information"
      },
      {
       "path": "$.Items[*].Name",
       "op": "notcontains",
       "value": "$RECYCLE.BIN"
      }
     ]
    }
   }
  ]
 },
 {
