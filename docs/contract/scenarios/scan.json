    "name": "the folder disappears",
    "request": {
     "method": "",
     "path": ""
    },
    "expect": {},
    "fs": {
     "remove": "Forget/Forget Gone (2352)"
    }
   },
   {
    "name": "a library refresh",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{library.forget.id}}/Refresh",
     "query": {
      "Recursive": "true",
      "MetadataRefreshMode": "Default",
      "ImageRefreshMode": "Default"
     }
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "the item is gone",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.forget-gone.id}}"
    },
    "expect": {
     "status": 404
    },
    "retryMs": 20000
   },
   {
    "name": "its neighbours stay",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.forget-keep.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Type",
       "op": "eq",
       "value": "Movie"
      }
     ]
    }
   },
   {
    "name": "the collection lost the member and stays",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{capture.col}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 1
      }
     ]
    }
   },
   {
    "name": "the collection is still there",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{capture.col}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Type",
       "op": "eq",
       "value": "BoxSet"
      }
     ]
    }
   }
  ],
  "cleanup": [
   {
    "name": "put it back",
    "request": {
     "method": "",
     "path": ""
    },
    "expect": {},
    "fs": {
     "copy": "ForgetBackup/forget-gone.mp4",
     "to": "Forget/Forget Gone (2352)/Forget Gone (2352).mp4"
    }
   },
   {
    "name": "remove the collection",
    "as": "admin",
    "request": {
     "method": "DELETE",
     "path": "/Items/{{capture.col}}"
    },
    "expect": {
     "status": [
      200,
      204,
      404
     ]
    }
   }
  ]
 },
