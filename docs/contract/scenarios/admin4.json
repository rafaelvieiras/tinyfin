     "method": "POST",
     "path": "/Library/VirtualFolders/Name",
     "query": {
      "name": "tmp-lib-rename-a",
      "newName": "tmp-lib-rename-a",
      "refreshLibrary": "false"
     }
    },
    "expect": {
     "status": 204
