      {
       "path": "$[?Name=Movies].Name",
       "op": "eq",
       "value": "Movies"
      },
      {
       "path": "$[?Name=tmp-lib-rename-a]",
       "op": "absent"
      }
     ]
    }
   }
  ],
  "cleanup": [
   {
    "name": "remove tmp-lib-rename-a",
    "as": "admin",
    "request": {
     "method": "DELETE",
     "path": "/Library/VirtualFolders",
     "query": {
      "name": "tmp-lib-rename-a",
      "refreshLibrary": "false"
     }
    },
    "expect": {}
   },
   {
    "name": "remove tmp-lib-rename-b",
    "as": "admin",
    "request": {
