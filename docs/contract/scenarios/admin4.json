    "expect": {
     "status": 404
    }
   },
   {
    "name": "libraries now",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Library/VirtualFolders"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[?Name=tmp-lib-rename-a].Name",
       "op": "eq",
       "value": "tmp-lib-rename-a"
      },
      {
       "path": "$[?Name=tmp-lib-rename-c]",
       "op": "absent"
      }
     ]
    }
   },
   {
    "name": "rename tmp-lib-rename-a to tmp-lib-rename-b",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Library/VirtualFolders/Name",
     "query": {
      "name": "tmp-lib-rename-a",
      "newName": "tmp-lib-rename-b",
      "refreshLibrary": "false"
     }
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "libraries now",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Library/VirtualFolders"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$[?Name=tmp-lib-rename-b].Name",
       "op": "eq",
       "value": "tmp-lib-rename-b"
