 {
  "id": "music.image.album",
  "endpoint": "GET /Items/{itemId}/Images/{imageType}",
  "spec": "music.md",
  "scope": "modern",
  "tags": [
   "music"
  ],
  "covers": [
   "music.image.R1",
   "music.image.R2",
   "music.image.R3"
  ],
  "requires": [
   "library:music",
   "item:malpha",
   "item:mdelta",
   "item:membedded",
   "item:mgamma",
   "item:mfirst"
  ],
  "steps": [
   {
    "name": "cover.jpg beside the tracks is the album picture",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.malpha.id}}/Images/Primary"
    },
    "expect": {
     "status": 200,
     "headers": {
      "Content-Type": "/^image\\/jpeg/"
     }
    }
   },
   {
    "name": "a picture embedded in a track is the track's picture",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.membedded.id}}/Images/Primary"
    },
    "expect": {
     "status": 200,
     "headers": {
      "Content-Type": "/^image\\/jpeg/"
     }
    },
    "retryMs": 30000
   },
   {
    "name": "... and the picture of its album",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mdelta.id}}/Images/Primary"
    },
    "expect": {
     "status": 200,
     "headers": {
      "Content-Type": "/^image\\/jpeg/"
     }
    }
   },
   {
    "name": "a track with no picture has none",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mfirst.id}}/Images/Primary"
    },
    "expect": {
     "status": 404
    }
   },
   {
    "name": "an album with no picture has none",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mgamma.id}}/Images/Primary"
    },
    "expect": {
     "status": 404
    }
   },
   {
    "name": "the track lists its picture",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.membedded.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.ImageTags.Primary",
       "op": "exists"
      },
      {
       "path": "$.AlbumPrimaryImageTag",
       "op": "exists"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "music.stream.direct",
