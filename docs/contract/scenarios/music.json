     "query": {
      "ParentId": "{{item.malpha.id}}",
      "SortBy": "SortName"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "First Song"
      },
      {
       "path": "$.Items[1].Name",
       "op": "eq",
       "value": "Second Song"
      },
      {
       "path": "$.Items[0].Type",
       "op": "eq",
       "value": "Audio"
      }
     ]
    }
   },
   {
    "name": "the same tracks by AlbumIds",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "Audio",
      "AlbumIds": "{{item.malpha.id}}",
      "SortBy": "SortName"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "First Song"
      },
      {
       "path": "$.Items[1].Name",
       "op": "eq",
       "value": "Second Song"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "music.artist.detail",
  "endpoint": "GET /Items/{itemId}",
  "spec": "music.md",
  "scope": "modern",
  "tags": [
   "music"
  ],
  "covers": [
   "music.artist.R1",
