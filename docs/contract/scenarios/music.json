      },
      {
       "path": "$.Container",
       "op": "eq",
       "value": "flac"
      },
      {
       "path": "$.RunTimeTicks",
       "op": "eq",
       "value": 20000000
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "music.track.untagged",
  "endpoint": "GET /Items/{itemId}",
  "spec": "music.md",
  "scope": "modern",
  "tags": [
   "music"
  ],
  "covers": [
   "music.scan.R2",
   "music.scan.R7"
  ],
  "requires": [
   "library:music",
   "item:muntagged",
   "item:mgamma"
  ],
  "steps": [
   {
    "name": "a file with no tags is named after the file and sits in its folder album",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.muntagged.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Type",
       "op": "eq",
       "value": "Audio"
      },
      {
       "path": "$.Name",
       "op": "eq",
       "value": "01 - Untagged Track"
      },
      {
       "path": "$.AlbumId",
       "op": "eq",
       "value": "{{item.mgamma.id}}"
      },
      {
       "path": "$.ParentId",
       "op": "eq",
       "value": "{{item.mgamma.id}}"
      },
      {
       "path": "$.Album",
       "op": "absent"
      },
      {
       "path": "$.AlbumArtist",
       "op": "absent"
      },
      {
       "path": "$.Artists",
       "op": "len",
       "value": 0
      },
      {
       "path": "$.ArtistItems",
       "op": "len",
       "value": 0
      },
      {
       "path": "$.AlbumArtists",
       "op": "len",
       "value": 0
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "music.track.guest-artist",
  "endpoint": "GET /Items/{itemId}",
  "spec": "music.md",
  "scope": "modern",
  "tags": [
   "music"
  ],
  "covers": [
   "music.track.R1",
   "music.track.R2"
  ],
  "requires": [
   "library:music",
   "item:mguest",
   "item:mvarious"
  ],
  "steps": [
   {
    "name": "the track artist differs from the album artist",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mguest.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Artists[0]",
       "op": "eq",
       "value": "Guest Singer"
      },
      {
       "path": "$.AlbumArtist",
       "op": "eq",
       "value": "Various Artists"
      },
      {
       "path": "$.ArtistItems[0].Name",
       "op": "eq",
       "value": "Guest Singer"
      },
      {
       "path": "$.ArtistItems[0].Id",
       "op": "ne",
       "value": "{{item.mvarious.id}}"
      },
      {
       "path": "$.AlbumArtists[0].Name",
       "op": "eq",
       "value": "Various Artists"
      },
      {
       "path": "$.AlbumArtists[0].Id",
       "op": "eq",
       "value": "{{item.mvarious.id}}"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "music.album.detail",
  "endpoint": "GET /Items/{itemId}",
  "spec": "music.md",
  "scope": "modern",
  "tags": [
   "music"
  ],
  "covers": [
   "music.album.R1",
   "music.album.R2",
   "music.album.R3",
   "music.scan.R4",
   "music.scan.R5"
  ],
  "requires": [
   "library:music",
   "item:malpha",
   "item:martist1",
   "item:mgamma",
   "item:mmixtape"
  ],
  "steps": [
   {
    "name": "an album named after its tags",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.malpha.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Type",
       "op": "eq",
       "value": "MusicAlbum"
      },
      {
       "path": "$.Name",
       "op": "eq",
       "value": "Album Alpha"
      },
      {
       "path": "$.IsFolder",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaType",
       "op": "eq",
       "value": "Unknown"
      },
      {
       "path": "$.ParentId",
       "op": "eq",
       "value": "{{item.martist1.id}}"
      },
      {
       "path": "$.AlbumArtist",
       "op": "eq",
       "value": "Artist One"
      },
      {
       "path": "$.Artists[0]",
       "op": "eq",
       "value": "Artist One"
      },
      {
       "path": "$.ArtistItems[0].Id",
       "op": "eq",
       "value": "{{item.martist1.id}}"
      },
      {
       "path": "$.AlbumArtists[0].Id",
       "op": "eq",
       "value": "{{item.martist1.id}}"
      },
      {
       "path": "$.ProductionYear",
       "op": "eq",
       "value": 2019
      },
      {
       "path": "$.Genres[0]",
       "op": "eq",
       "value": "Rock"
      },
      {
       "path": "$.ChildCount",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.RecursiveItemCount",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.ImageTags.Primary",
       "op": "exists"
      }
     ]
    }
   },
   {
    "name": "an album with no tags is named after its folder",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mgamma.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Type",
       "op": "eq",
       "value": "MusicAlbum"
      },
      {
       "path": "$.Name",
       "op": "eq",
       "value": "Album Gamma"
      },
      {
       "path": "$.ChildCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.AlbumArtist",
       "op": "absent"
      },
      {
       "path": "$.ImageTags.Primary",
       "op": "absent"
      }
     ]
    }
   },
   {
    "name": "the album artist and the track artist are two members",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mmixtape.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.AlbumArtist",
       "op": "eq",
       "value": "Various Artists"
      },
      {
       "path": "$.Artists[0]",
       "op": "eq",
       "value": "Guest Singer"
      },
      {
       "path": "$.ArtistItems[0].Name",
       "op": "eq",
       "value": "Guest Singer"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "music.album.tracks",
  "endpoint": "GET /Items",
  "spec": "music.md",
  "scope": "modern",
  "tags": [
   "music"
  ],
  "covers": [
   "music.album.R4",
   "music.list.R4"
  ],
  "requires": [
   "library:music",
   "item:malpha",
   "item:mfirst"
  ],
  "steps": [
   {
    "name": "the children of an album in track order",
    "as": "admin",
    "request": {
     "method": "GET",
