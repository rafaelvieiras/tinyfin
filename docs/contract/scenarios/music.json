[
 {
  "id": "music.scan.library",
  "endpoint": "GET /Items",
  "spec": "music.md",
  "scope": "modern",
  "tags": [
   "music"
  ],
  "covers": [
   "music.scan.R1",
   "music.list.R1"
  ],
  "requires": [
   "library:music",
   "item:mfirst"
  ],
  "steps": [
   {
    "name": "six tracks",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "Audio",
      "ParentId": "{{library.music.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 6
      },
      {
       "path": "$.Items[0].Type",
       "op": "eq",
       "value": "Audio"
      }
     ]
    },
    "retryMs": 30000
   },
   {
    "name": "five albums",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "MusicAlbum",
      "ParentId": "{{library.music.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 5
      },
      {
       "path": "$.Items[0].Type",
       "op": "eq",
       "value": "MusicAlbum"
      }
     ]
    }
   },
   {
    "name": "at least the three artist folders",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "MusicArtist"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "gte",
       "value": 3
      },
      {
       "path": "$.Items[0].Type",
       "op": "eq",
       "value": "MusicArtist"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "music.track.id3",
  "endpoint": "GET /Items/{itemId}",
  "spec": "music.md",
  "scope": "modern",
  "tags": [
   "music"
  ],
  "covers": [
   "music.scan.R2",
   "music.scan.R3",
   "music.track.R1",
   "music.track.R2",
   "music.track.R3",
   "music.album.R3"
  ],
  "requires": [
   "library:music",
   "item:mfirst",
   "item:malpha",
   "item:martist1"
  ],
  "steps": [
   {
    "name": "a track tagged with ID3",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.mfirst.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Type",
       "op": "eq",
       "value": "Audio"
      },
      {
       "path": "$.Name",
       "op": "eq",
       "value": "First Song"
      },
      {
       "path": "$.MediaType",
       "op": "eq",
       "value": "Audio"
      },
      {
       "path": "$.IsFolder",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.Album",
       "op": "eq",
       "value": "Album Alpha"
      },
      {
       "path": "$.AlbumId",
       "op": "eq",
       "value": "{{item.malpha.id}}"
      },
      {
       "path": "$.ParentId",
       "op": "eq",
       "value": "{{item.malpha.id}}"
      },
      {
       "path": "$.AlbumArtist",
       "op": "eq",
       "value": "Artist One"
      },
      {
       "path": "$.Artists[0]",
       "op": "eq",
       "value": "Artist One"
      },
      {
       "path": "$.ArtistItems[0].Name",
       "op": "eq",
       "value": "Artist One"
      },
      {
       "path": "$.ArtistItems[0].Id",
       "op": "eq",
       "value": "{{item.martist1.id}}"
      },
      {
       "path": "$.AlbumArtists[0].Name",
       "op": "eq",
       "value": "Artist One"
      },
      {
       "path": "$.AlbumArtists[0].Id",
       "op": "eq",
       "value": "{{item.martist1.id}}"
      },
      {
       "path": "$.IndexNumber",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.ParentIndexNumber",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.ProductionYear",
       "op": "eq",
       "value": 2019
      },
      {
       "path": "$.Genres[0]",
       "op": "eq",
       "value": "Rock"
      },
      {
       "path": "$.Container",
       "op": "eq",
       "value": "mp3"
      },
      {
       "path": "$.AlbumPrimaryImageTag",
       "op": "exists"
      },
      {
       "path": "$.MediaSources[0].Name",
       "op": "eq",
       "value": "01 - First Song"
      },
      {
       "path": "$.MediaSources[0].Container",
       "op": "eq",
       "value": "mp3"
      },
      {
       "path": "$.MediaSources[0].MediaStreams[0].Type",
       "op": "eq",
       "value": "Audio"
      },
      {
       "path": "$.MediaSources[0].MediaStreams[0].Codec",
       "op": "eq",
       "value": "mp3"
      },
      {
       "path": "$.RunTimeTicks",
       "op": "gte",
       "value": 1
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
