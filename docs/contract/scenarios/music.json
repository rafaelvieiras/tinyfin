   "item:mfirst",
   "item:mopening"
  ],
  "steps": [
   {
    "name": "the file as it is",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Audio/{{item.mfirst.id}}/stream",
     "query": {
      "static": "true"
     }
    },
    "expect": {
     "status": 200,
     "headers": {
      "Content-Type": "/^audio\\/mpeg/",
      "Accept-Ranges": "bytes"
     }
    }
   },
   {
    "name": "a range of it",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Audio/{{item.mopening.id}}/stream",
     "query": {
      "static": "true"
     },
     "headers": {
      "Range": "bytes=0-99"
     }
    },
    "expect": {
     "status": 206,
     "headers": {
      "Content-Type": "/^audio\\/flac/",
      "Content-Range": "/^bytes 0-99\\//"
     }
    }
   }
  ],
  "cleanup": []
 },
