       "op": "eq",
       "value": "MusicArtist"
      },
      {
       "path": "$.Name",
       "op": "eq",
       "value": "Artist One"
      },
      {
       "path": "$.IsFolder",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaType",
       "op": "eq",
       "value": "Unknown"
      },
      {
       "path": "$.SongCount",
       "op": "eq",
       "value": 3
      },
      {
       "path": "$.AlbumCount",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.ChildCount",
       "op": "eq",
       "value": 5
      }
     ]
    }
   },
   {
    "name": "its albums are its children",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "ParentId": "{{item.martist1.id}}",
      "SortBy": "SortName"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 2
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "Album Alpha"
      },
      {
       "path": "$.Items[1].Name",
       "op": "eq",
       "value": "Album Beta"
      },
      {
       "path": "$.Items[0].Type",
       "op": "eq",
       "value": "MusicAlbum"
      }
     ]
    }
   },
   {
    "name": "a folder artist whose album has no tags counts only what is tagged",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{item.martist2.id}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.SongCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.AlbumCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.ChildCount",
       "op": "eq",
       "value": 2
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
 {
  "id": "music.artists.list",
  "endpoint": "GET /Artists",
  "spec": "music.md",
  "scope": "modern",
  "tags": [
   "music"
  ],
  "covers": [
   "music.list.R2",
   "music.list.R3",
   "music.artist.R3"
  ],
  "requires": [
   "library:music",
   "item:martist1"
  ],
  "steps": [
   {
    "name": "the artists of tracks, with the ones that have no folder",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Artists",
     "query": {
      "userId": "{{user.admin.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 3
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "Artist One"
      },
      {
       "path": "$.Items[0].Id",
       "op": "eq",
       "value": "{{item.martist1.id}}"
      },
      {
       "path": "$.Items[0].Type",
       "op": "eq",
       "value": "MusicArtist"
      },
      {
       "path": "$.Items[1].Name",
       "op": "eq",
       "value": "Artist Two"
      },
      {
       "path": "$.Items[2].Name",
       "op": "eq",
       "value": "Guest Singer"
      }
     ]
    },
    "retryMs": 30000
   },
   {
    "name": "the album artists",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Artists/AlbumArtists",
     "query": {
      "userId": "{{user.admin.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 3
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "Artist One"
      },
      {
       "path": "$.Items[1].Name",
       "op": "eq",
       "value": "Artist Two"
      },
      {
       "path": "$.Items[2].Name",
       "op": "eq",
       "value": "Various Artists"
      }
     ]
    }
   },
   {
    "name": "an artist with no folder is found by search and read by id",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Artists",
     "query": {
      "SearchTerm": "Guest",
      "userId": "{{user.admin.id}}"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.Items[0].Name",
       "op": "eq",
       "value": "Guest Singer"
      },
      {
       "path": "$.Items[0].Type",
       "op": "eq",
       "value": "MusicArtist"
      }
     ]
    },
    "capture": {
     "guest": "$.Items[0].Id"
    }
   },
   {
    "name": "the artist item",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items/{{guest}}"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Type",
       "op": "eq",
       "value": "MusicArtist"
      },
      {
       "path": "$.Name",
       "op": "eq",
       "value": "Guest Singer"
      },
      {
       "path": "$.SongCount",
       "op": "eq",
       "value": 1
      },
      {
       "path": "$.AlbumCount",
       "op": "eq",
       "value": 1
      }
     ]
    }
   },
   {
    "name": "once seen, it is a MusicArtist of the item listing too",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Items",
     "query": {
      "Recursive": "true",
      "IncludeItemTypes": "MusicArtist"
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.TotalRecordCount",
       "op": "gte",
       "value": 4
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
