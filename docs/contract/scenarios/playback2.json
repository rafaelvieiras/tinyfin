[
 {
  "id": "playback.offer.container-only",
  "endpoint": "POST /Items/{itemId}/PlaybackInfo",
  "spec": "playback.md#offer",
  "scope": "modern",
  "tags": [
   "playback"
  ],
  "covers": [
   "playback.offer.R1"
  ],
  "requires": [
   "library:avtrack",
   "item:av-multi"
  ],
  "steps": [
   {
    "name": "codecs fit, the container does not: transcode, no direct stream (hls)",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-multi.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.av-multi.id}}"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mp4",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "vtt",
         "Method": "External"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.MediaSources[0].SupportsDirectStream",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.MediaSources[0].SupportsTranscoding",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].TranscodingSubProtocol",
       "op": "eq",
       "value": "hls"
      },
      {
       "path": "$.MediaSources[0].TranscodingContainer",
       "op": "eq",
       "value": "ts"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "master.m3u8?"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "matches",
       "value": "TranscodeReasons=ContainerNotSupported$"
      }
     ]
    }
   },
   {
    "name": "an audio track the profile cannot take: still no direct stream",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-multi.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.av-multi.id}}",
      "AudioStreamIndex": "2"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mkv",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "vtt",
         "Method": "External"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.MediaSources[0].SupportsDirectStream",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.MediaSources[0].SupportsTranscoding",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "matches",
       "value": "TranscodeReasons=AudioCodecNotSupported$"
      }
     ]
    }
   },
   {
    "name": "the file the profile plays stays direct play",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-multi.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.av-multi.id}}"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mkv",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "vtt",
         "Method": "External"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].SupportsDirectStream",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "absent"
      }
     ]
    }
   }
  ]
 },
 {
  "id": "playback.offer.http-profile",
  "endpoint": "POST /Items/{itemId}/PlaybackInfo",
  "spec": "playback.md#offer",
  "scope": "modern",
  "tags": [
   "playback"
  ],
  "covers": [
   "playback.offer.R2",
   "playback.offer.R6"
  ],
  "requires": [
   "library:avtrack",
   "item:av-multi"
  ],
  "steps": [
   {
    "name": "an http transcoding profile is a progressive stream",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-multi.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.av-multi.id}}"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mp4",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "mp4",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "http",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "vtt",
         "Method": "External"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.MediaSources[0].SupportsDirectStream",
       "op": "eq",
       "value": false
      },
      {
       "path": "$.MediaSources[0].SupportsTranscoding",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].TranscodingSubProtocol",
       "op": "eq",
       "value": "http"
      },
      {
       "path": "$.MediaSources[0].TranscodingContainer",
       "op": "eq",
       "value": "mp4"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "matches",
       "value": "^/videos/[0-9a-f-]{36}/stream\\.mp4\\?"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "notcontains",
       "value": "SegmentContainer"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "notcontains",
       "value": "master.m3u8"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "matches",
       "value": "TranscodeReasons=ContainerNotSupported$"
      }
     ]
    },
    "capture": {
     "url": "$.MediaSources[0].TranscodingUrl"
    }
   },
   {
    "name": "the URL answers the transcoded stream",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "{{capture.url}}"
    },
    "expect": {
     "status": 200,
     "headers": {
      "Content-Type": "/video\\/mp4/"
     }
    }
   },
   {
    "name": "the container of the entry names the file",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-multi.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.av-multi.id}}"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mp4",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "mkv",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "http",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "vtt",
         "Method": "External"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].TranscodingSubProtocol",
       "op": "eq",
       "value": "http"
      },
      {
       "path": "$.MediaSources[0].TranscodingContainer",
       "op": "eq",
       "value": "mkv"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "matches",
       "value": "/stream\\.mkv\\?"
      }
     ]
    }
   },
   {
    "name": "an entry without a protocol is progressive too",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-multi.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.av-multi.id}}"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mp4",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "vtt",
         "Method": "External"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].TranscodingSubProtocol",
       "op": "eq",
       "value": "http"
      },
      {
       "path": "$.MediaSources[0].TranscodingContainer",
       "op": "eq",
       "value": "ts"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "matches",
       "value": "/stream\\.ts\\?"
      }
     ]
    }
   },
   {
    "name": "the protocol is compared without case",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-multi.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.av-multi.id}}"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mp4",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "HLS",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "vtt",
         "Method": "External"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].TranscodingSubProtocol",
       "op": "eq",
       "value": "hls"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "contains",
       "value": "master.m3u8?"
      }
     ]
    }
   },
   {
    "name": "an entry for the static context is skipped",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-multi.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.av-multi.id}}"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mp4",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "mp4",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "http",
         "Context": "Static"
        },
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "vtt",
         "Method": "External"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].TranscodingSubProtocol",
       "op": "eq",
       "value": "hls"
      },
      {
       "path": "$.MediaSources[0].TranscodingContainer",
       "op": "eq",
       "value": "ts"
      }
     ]
    }
   }
  ]
 },
 {
  "id": "playback.offer.no-profile",
  "endpoint": "POST /Items/{itemId}/PlaybackInfo",
  "spec": "playback.md#offer",
  "scope": "modern",
  "tags": [
   "playback"
  ],
  "covers": [
   "playback.offer.R3"
  ],
  "requires": [
   "library:avtrack",
   "item:av-multi",
   "item:av-plain"
  ],
  "steps": [
   {
    "name": "no device profile: the file is offered as it is, whatever its container",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-multi.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.av-multi.id}}"
     },
     "body": {}
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].SupportsDirectStream",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].SupportsTranscoding",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "absent"
      }
     ]
    }
   },
   {
    "name": "an audio track selection changes nothing",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-multi.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.av-multi.id}}",
      "AudioStreamIndex": "2"
     },
     "body": {}
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "absent"
      }
     ]
    }
   },
   {
    "name": "a plain mp4 as well",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-plain.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.av-plain.id}}"
     },
     "body": {}
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].SupportsDirectPlay",
       "op": "eq",
       "value": true
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "absent"
      }
     ]
    }
   }
  ]
 },
 {
  "id": "playback.offer.url-params",
  "endpoint": "POST /Items/{itemId}/PlaybackInfo",
  "spec": "playback.md#offer-url",
  "scope": "modern",
  "tags": [
   "playback"
  ],
  "covers": [
   "playback.offer.R4",
   "playback.offer.R5"
  ],
  "requires": [
   "library:avtrack",
   "item:av-multi"
  ],
  "steps": [
   {
    "name": "the members of the URL, in the reference order",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-multi.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.av-multi.id}}"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mp4",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "vtt",
         "Method": "External"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "matches",
       "value": "^/videos/[0-9a-f-]{36}/master\\.m3u8\\?DeviceId=[^&]+&MediaSourceId=[0-9a-f]{32}&VideoCodec=h264&AudioCodec=aac&AudioStreamIndex=1&VideoBitrate=\\d+&AudioBitrate=\\d+&(AudioSampleRate=\\d+&)?(MaxFramerate=[\\d.]+&)?SegmentContainer=ts&PlaySessionId=[0-9a-f]{32}&ApiKey=[0-9a-f]+&RequireAvc=false&EnableAudioVbrEncoding=true&Tag=[0-9a-f]{32}&h264-level=\\d+&h264-videobitdepth=8&h264-profile=[a-z0-9]+&"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "matches",
       "value": "TranscodeReasons=ContainerNotSupported$"
      },
      {
       "path": "$.MediaSources[0].Bitrate",
       "op": "gte",
       "value": 1
      },
      {
       "path": "$.MediaSources[0].DefaultAudioStreamIndex",
       "op": "eq",
       "value": 1
      }
     ]
    }
   },
   {
    "name": "the lists and flags of the transcoding entry",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-multi.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.av-multi.id}}"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mp4",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "hevc,h264",
         "AudioCodec": "mp3,aac",
         "Protocol": "hls",
         "Context": "Streaming",
         "MaxAudioChannels": "2",
         "MinSegments": 2,
         "SegmentLength": 6,
         "EnableMpegtsM2TsMode": true,
         "CopyTimestamps": true,
         "EnableSubtitlesInManifest": true
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "vtt",
         "Method": "External"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "matches",
       "value": "^/videos/[0-9a-f-]{36}/master\\.m3u8\\?DeviceId=[^&]+&MediaSourceId=[0-9a-f]{32}&VideoCodec=hevc,h264&AudioCodec=aac&AudioStreamIndex=1&VideoBitrate=\\d+&AudioBitrate=\\d+&(AudioSampleRate=\\d+&)?(MaxFramerate=[\\d.]+&)?SegmentContainer=ts&SegmentLength=6&MinSegments=2&PlaySessionId=[0-9a-f]{32}&ApiKey=[0-9a-f]+&TranscodingMaxAudioChannels=2&EnableSubtitlesInManifest=True&EnableMpegtsM2TsMode=True&CopyTimestamps=True&RequireAvc=false&"
      }
     ]
    }
   },
   {
    "name": "a track the profile re-encodes: the target list, no audio members of the source",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-multi.id}}/PlaybackInfo",
     "query": {
      "MediaSourceId": "{{item.av-multi.id}}",
      "AudioStreamIndex": "2"
     },
     "body": {
      "DeviceProfile": {
       "Name": "conformance",
       "MaxStreamingBitrate": 120000000,
       "DirectPlayProfiles": [
        {
         "Container": "mkv",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac"
        }
       ],
       "TranscodingProfiles": [
        {
         "Container": "ts",
         "Type": "Video",
         "VideoCodec": "h264",
         "AudioCodec": "aac",
         "Protocol": "hls",
         "Context": "Streaming"
        }
       ],
       "SubtitleProfiles": [
        {
         "Format": "vtt",
         "Method": "External"
        }
       ]
      }
     }
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "matches",
       "value": "^/videos/[0-9a-f-]{36}/master\\.m3u8\\?DeviceId=[^&]+&MediaSourceId=[0-9a-f]{32}&VideoCodec=h264&AudioCodec=aac&AudioStreamIndex=2&VideoBitrate=\\d+&AudioBitrate=\\d+&(MaxFramerate=[\\d.]+&)?SegmentContainer=ts&"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "notcontains",
       "value": "AudioSampleRate"
      },
      {
       "path": "$.MediaSources[0].TranscodingUrl",
       "op": "notcontains",
       "value": "aac-profile"
      }
     ]
    }
   },
   {
    "name": "a burned-in subtitle: its index after the audio track, its method after the tag",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/Items/{{item.av-multi.id}}/PlaybackInfo",
