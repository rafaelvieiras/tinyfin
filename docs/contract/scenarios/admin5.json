[
 {
  "id": "admin.mediafolders.path-etag",
  "endpoint": "GET /Library/MediaFolders",
  "spec": "admin.md#pages",
  "scope": "modern",
  "tags": [
   "admin"
  ],
  "covers": [
   "admin.pages.R5"
  ],
  "requires": [
   "user:alice",
   "library:movies"
  ],
  "steps": [
   {
    "name": "first read",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Library/MediaFolders"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[?Name=Movies].Path",
       "op": "type",
       "value": "string"
      },
      {
       "path": "$.Items[?Name=Movies].Etag",
       "op": "matches",
       "value": "^[0-9a-f]{32}$"
      },
      {
       "path": "$.Items[?Name=Playlists].Path",
       "op": "type",
       "value": "string"
      },
      {
       "path": "$.Items[?Name=Playlists].Etag",
       "op": "matches",
       "value": "^[0-9a-f]{32}$"
      },
      {
       "path": "$.Items[?Name=Movies].Type",
       "op": "eq",
       "value": "CollectionFolder"
      },
      {
       "path": "$.Items[?Name=Playlists].Type",
       "op": "eq",
       "value": "ManualPlaylistsFolder"
      }
     ]
    }
   },
   {
    "name": "capture",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Library/MediaFolders"
    },
    "expect": {
     "status": 200
    },
    "capture": {
     "movies_etag": "$.Items[?Name=Movies].Etag"
    }
   },
   {
    "name": "etag is stable",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Library/MediaFolders"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[?Name=Movies].Etag",
       "op": "eq",
       "value": "{{capture.movies_etag}}"
      },
      {
       "path": "$.Items[?Name=Movies].Path",
       "op": "matches",
       "value": "^/.+"
      }
     ]
    }
   },
   {
    "name": "hidden filter keeps the fields",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/Library/MediaFolders?isHidden=true"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.Items[0].Etag",
       "op": "matches",
       "value": "^[0-9a-f]{32}$"
      },
      {
       "path": "$.Items[0].Path",
       "op": "matches",
       "value": "^/.+"
      }
     ]
    }
   }
  ],
  "cleanup": []
 },
