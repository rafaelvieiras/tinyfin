 {
  "id": "admin.config.hwaccel-invalid",
  "endpoint": "POST /System/Configuration/encoding",
  "spec": "admin.md#config",
  "scope": "modern",
  "tags": [
   "admin"
  ],
  "covers": [
   "admin.config.R8"
  ],
  "requires": [],
  "steps": [
   {
    "name": "remember the section",
    "config": {
     "section": "encoding",
     "set": {}
    }
   },
   {
    "name": "known value",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/System/Configuration/encoding",
     "body": {
      "HardwareAccelerationType": "qsv"
     }
    },
    "expect": {
     "status": 204
    }
   },
   {
    "name": "unknown name",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/System/Configuration/encoding",
     "body": {
      "HardwareAccelerationType": "bogus"
     }
    },
    "expect": {
     "status": 400
    }
   },
   {
    "name": "unchanged after unknown name",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/System/Configuration/encoding"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.HardwareAccelerationType",
       "op": "eq",
       "value": "qsv"
      }
     ]
    }
   },
   {
    "name": "empty string",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/System/Configuration/encoding",
     "body": {
      "HardwareAccelerationType": ""
     }
    },
    "expect": {
     "status": 400
    }
   },
   {
    "name": "unchanged after empty string",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/System/Configuration/encoding"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.HardwareAccelerationType",
       "op": "eq",
       "value": "qsv"
      }
     ]
    }
   },
   {
    "name": "null",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/System/Configuration/encoding",
     "body": {
      "HardwareAccelerationType": null
     }
    },
    "expect": {
     "status": 400
    }
   },
   {
    "name": "unchanged after null",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/System/Configuration/encoding"
    },
    "expect": {
     "status": 200,
     "json": [
      {
       "path": "$.HardwareAccelerationType",
       "op": "eq",
       "value": "qsv"
      }
     ]
    }
   },
   {
    "name": "number",
    "as": "admin",
    "request": {
     "method": "POST",
     "path": "/System/Configuration/encoding",
     "body": {
      "HardwareAccelerationType": 99
     }
    },
    "expect": {
     "status": 400
    }
   },
   {
    "name": "unchanged after number",
    "as": "admin",
    "request": {
     "method": "GET",
     "path": "/System/Configuration/encoding"
    },
    "expect": {
     "status": 200,
