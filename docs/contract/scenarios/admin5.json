       "op": "eq",
       "value": "qsv"
      }
     ]
    }
   }
  ],
  "cleanup": [],
  "divergence": {
   "reason": "The reference answers 500 (plain-text 'Error processing request.') for an unknown, empty, null, numeric out-of-range or non-string HardwareAccelerationType, and accepts the numeric spellings 1 and \"1\" as enum ordinals. Tinyfin refuses every value that is not a known name (case-insensitive, trimmed) with 400 and leaves the section unchanged; a 500 for a bad request is not reproduced."
  }
 }
